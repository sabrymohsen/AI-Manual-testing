# Recorder service — the live-recording HTTP + WebSocket server that drives a
# Playwright browser for interactive recording sessions.
#
# Uses the official Playwright image so Chromium/Firefox/WebKit and system libs
# match the installed playwright version (1.60.0). Point a Railway service at
# this file with RAILWAY_DOCKERFILE_PATH=Dockerfile.recorder, give it a public
# domain (the browser connects to the WSS stream directly), and set
# RECORDER_WORKER_SECRET (shared with the app) to protect the control endpoints.
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

# Arabic (and other right-to-left) pages: the Playwright image has no Arabic
# font, so Chrome fell back to FreeMono — letters spaced apart, not joined —
# in Live QA, recordings and screenshots. Noto Sans Arabic UI (5 MB) plus a
# fontconfig rule that prefers it for Arabic text.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-ui-core \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/fonts/65-arabic.conf /etc/fonts/conf.d/65-arabic.conf
RUN fc-cache -f

WORKDIR /app

# Install all dependencies. tsx is a devDependency, so do NOT omit dev deps.
COPY package.json package-lock.json* ./
RUN npm ci

# App source + Prisma schema.
COPY . .

# Generate the Prisma client from the real schema.
RUN npx prisma generate

ENV NODE_ENV=production

# The server binds 0.0.0.0 and honors $PORT (injected by Railway).
CMD ["npm", "run", "recorder-worker"]
