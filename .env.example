DATABASE_URL="postgresql://qa_user:qa_password@localhost:5432/ai_manual_qa_tester"
REDIS_URL="redis://localhost:6379"

NEXTAUTH_SECRET="replace-with-secure-secret"
NEXTAUTH_URL="http://localhost:3000"

# Exactly 32 bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A passphrase pasted in raw will NOT work — it decodes to the wrong length.
APP_ENCRYPTION_KEY=""
APP_ENCRYPTION_KEY_VERSION="v1"

OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""

# AI Test Case Generation (Free options)
OLLAMA_URL="http://localhost:11434"
HUGGINGFACE_API_TOKEN=""

# How long an AI bug draft waits on the configured provider before falling back
# to the rule-based template. Default 90000. Raise it where the route to the
# provider is long (a Moonshot .cn key reached from a US region); lower it if
# testers would rather have the template quickly.
AI_DRAFT_TIMEOUT_MS="90000"

# Output ceiling for an AI bug draft. Default 4000. A backstop against a
# runaway reply, not a budget to trim: Arabic drafts and models that reason
# before answering (kimi-k2.7, k3) need the room, and a truncated reply costs
# the whole draft. Bound the wait with AI_DRAFT_TIMEOUT_MS instead.
AI_DRAFT_MAX_TOKENS="4000"

FIGMA_API_TOKEN=""

STORAGE_ROOT="./storage"

PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_DEFAULT_BROWSER="chromium"
