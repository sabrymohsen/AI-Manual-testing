# storage
storage/screenshots/*
storage/avatars/*
storage/brds/*
storage/figma/*
storage/diffs/*
storage/traces/*
storage/videos/*
storage/exports/*
storage/dom_snapshots/*
storage/recordings/*
# Generated per run by the Automation Hub: the Playwright workspace (specs,
# config, traces, video). Runtime output, and traces run to tens of MB.
storage/hub-workspace/
# One directory per Story Agent run (screenshots, DOM snapshots, run artifacts).
# Runtime output only.
storage/story-agent-runs/
# Visual test screenshots, baselines and diffs. Runtime output only.
storage/visual-tests/
# Automation Hub Visual Diff baselines/current/diffs (served by /api/hub/visual/image)
storage/visual/
# Local agent tooling state
.claude-flow/
.swarm/
# Runtime persistence marker — must never be committed or baked into an image,
# or a wiped volume would still look persistent. See src/lib/storage-health.ts
storage/.storage-marker.json
!storage/.gitkeep

# playwright and testing temp files
playwright-report/
test-results/


# runtime user uploads & local scratch
public/uploads/avatars/
preview-screenshot.png

# Session recordings, raw captures and finished alike. Runtime output, not
# source: session-manager writes raw/ during a session, copies the finished
# file to public/videos/<sessionId>.webm, and resolves the URL by probing the
# filesystem (fs.access) — a missing file just means no video link, never an
# error. Each deployment records its own; the committed ones were one laptop's
# and were dead weight everywhere else, at 205 MB and growing per session.
public/videos/

# Local Claude Code settings
.claude/settings.local.json

# Graphify knowledge graph of this repo (generated, local). Rebuild: graphify update .
graphify-out/

# Local scratch: brainstorm mockups, browser-test artifacts, side dev-server build
.superpowers/
.playwright-mcp/
.next-verify/

# playwright agent-cli scratch
.playwright-cli/
