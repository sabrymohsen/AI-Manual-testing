# Runtime persistence marker — must never be committed or baked into an image,
# or a wiped volume would still look persistent. See src/lib/storage-health.ts
storage/.storage-marker.json
!storage/.gitkeep

# playwright and testing temp files
playwright-report/
test-results/


# runtime user uploads & local scratch
public/uploads/avatars/
preview-screenshot.png

# Playwright's raw per-session capture. Scratch, not an asset: the served copy
# is written to public/videos/<sessionId>.webm by session-manager.ts, and
# nothing — no EvidenceFile row, no BugReport.videoUrl — ever points in here.
# These are large (individual files reach 87 MB), so keep them out of history.
public/videos/raw/

# Local Claude Code settings
.claude/settings.local.json
