# Worker service — runs the BullMQ queue consumers that drive Playwright browsers.
#
# Uses the official Playwright image so Chromium/Firefox/WebKit and all system
# libraries match the installed playwright version (1.60.0). Point a Railway
# service at this file with RAILWAY_DOCKERFILE_PATH=Dockerfile.worker.
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

# Arabic (and other right-to-left) pages: the Playwright image has no Arabic
# font, so Chrome fell back to FreeMono — letters spaced apart, not joined —
# in Live QA, recordings and screenshots. Noto Sans Arabic UI (5 MB) plus a
# fontconfig rule that prefers it for Arabic text.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-ui-core \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/fonts/65-arabic.conf /etc/fonts/conf.d/65-arabic.conf
RUN fc-cache -f

WORKDIR /app

# Install all dependencies. tsx is a devDependency, so do NOT omit dev deps.
COPY package.json package-lock.json* ./
RUN npm ci

# App source + Prisma schema.
COPY . .

# Generate the Prisma client from the real schema (same reason as the app image).
RUN npx prisma generate

ENV NODE_ENV=production

# Run every background queue worker in a single process.
CMD ["npm", "run", "workers"]
