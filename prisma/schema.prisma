datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; the openssl-3.0.x targets cover the deployed
  // containers (Alpine app image / Debian worker + recorder images). Pinned
  // explicitly because Prisma's openssl auto-detection fails on Alpine and
  // would otherwise generate the wrong (linux-musl / openssl-1.1) engine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Environment {
  Dev
  Staging
  UAT
  Production
}

enum BrowserType {
  Chromium
  Firefox
  WebKit
}

enum ViewportType {
  Desktop
  Tablet
  Mobile
  Custom
}

enum TestType {
  Functional
  VisualDesign
  E2E
  Regression
  Smoke
  Exploratory
}

enum Priority {
  Low
  Medium
  High
  Critical
}

enum RequirementStatus {
  Draft
  ReadyForTesting
  InTesting
  Covered
  PartiallyCovered
  Failed
  Blocked
  Deprecated
}

enum RequirementSource {
  Manual
  ExcelImport
  Jira
  AzureDevOps
  GitHub
  Figma
  AIGenerated
  OpenProject
}

enum TestRunStatus {
  Queued
  Running
  Passed
  Failed
  Blocked
  Warning
  Cancelled
}

enum StepStatus {
  Pending
  Running
  Passed
  Failed
  Blocked
  Warning
  Skipped
  SelfHealed
}

enum ExecutionMode {
  Normal
  SelfHealing
  Debug
}

enum ExecutionType {
  Manual
  Automated
}

enum TestCaseSource {
  Manual
  AIGenerated
  Imported
  Exploratory
  Recorder
  QAAgentBrain
  RequirementFile
}

enum ActionType {
  open_url
  click
  fill
  select
  select_custom
  select_searchable
  multi_select
  remove_multi_select_value
  autocomplete_select
  date_select
  time_select
  upload_file
  check
  uncheck
  radio_select
  tab_select
  menu_select
  modal_open
  modal_close
  table_row_select
  pagination_next
  pagination_previous
  accordion_expand
  accordion_collapse
  toggle_on
  toggle_off
  slider_set
  wait_for_text
  wait_for_url
  assert_visible
  assert_hidden
  assert_text
  assert_url
  assert_api_status
  screenshot
  custom_instruction
  visible
  hidden
  text_contains
  text_equals
  value_equals
  url_equals
  url_contains
  title_contains
  wait
  note
}

enum TargetType {
  test_id
  role
  text
  label
  placeholder
  css
  xpath
  url
  none
}

enum LogLevel {
  info
  warning
  error
  debug
}

enum LogSource {
  browser
  server
  playwright
  ai
  network
}

enum JobStatus {
  Queued
  Running
  Completed
  Failed
  Cancelled
}

enum UserPlan {
  Free
  Pro
}

enum UserRole {
  User
  Admin
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String?
  plan           UserPlan  @default(Free)
  role           UserRole  @default(User)
  isActive       Boolean   @default(true)
  // Free-trial lifecycle. On signup a user gets a Pro trial: plan=Pro with
  // trialEndsAt in the future. When trialEndsAt elapses they are downgraded to
  // Free (trialEndsAt is kept, in the past, so it reads as an "expired trial").
  // A paid Pro user has trialEndsAt = null (never auto-downgrades).
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projects     Project[]
  auditLogs    AuditLog[]
  reportedBugs BugReport[]   @relation("BugReporter")
  transactions Transaction[]

  // ── Scrum board (spec-literal parallel system) ──
  avatarUrl              String?
  scrumTasks             Task[]           @relation("ScrumTaskAssignees")
  reportedScrumTasks     Task[]           @relation("ScrumTaskReporter")
  votedScrumTasks        Task[]           @relation("ScrumTaskVoters")
  watchedScrumTasks      Task[]           @relation("ScrumTaskWatchers")
  scrumTaskAttachments   TaskAttachment[] @relation("ScrumTaskAttachmentUploader")
  scrumWorkLogs          WorkLog[]        @relation("ScrumWorkLogAuthor")
  scrumComments          Comment[]
  scrumActivities        Activity[]
  projectMemberships     ProjectMember[]
}

// Generic platform key/value settings (e.g. default trial length). Admin-editable.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id            String   @id @default(uuid())
  name          String
  price         Float
  billingPeriod String // "monthly" | "yearly"
  features      String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  status    String // "Success" | "Failed"
  plan      UserPlan
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  webAppUrl   String
  figmaUrl    String?
  description String?
  environment Environment   @default(Staging)
  browserType BrowserType   @default(Chromium)
  viewport    ViewportType  @default(Desktop)
  testType    TestType      @default(Functional)
  status      ProjectStatus @default(Active)

  customViewportWidth  Int?
  customViewportHeight Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentials        ProjectCredential[]
  figmaConfig        FigmaConfig?
  integrationConfig  IntegrationConfig?
  testCases          TestCase[]
  testRuns           TestRun[]
  auditLogs          AuditLog[]
  elementLocators    ElementLocator[]
  elementCollections ElementCollection[]
  recordingSessions  RecordingSession[]
  features           Feature[]

  manualTestSessions      ManualTestSession[]
  reusableStepFlows       ReusableStepFlow[]
  testDataVariables       TestDataVariable[]
  requirements            Requirement[]
  epics                   Epic[]
  requirementImports      RequirementImport[]
  bugReports              BugReport[]
  figmaFrames             FigmaFrame[]
  visualCheckMappings     VisualCheckMapping[]
  visualToleranceProfiles VisualToleranceProfile[]
  visualCheckRuns         VisualCheckRun[]
  autonomousAgentRuns     AutonomousAgentRun[]
  agentBrainRuns          AgentBrainRun[]
  agentMemories           AgentMemory[]
  qaAgentRuns             QAAgentRun[]
  openProjectIntegration  OpenProjectIntegration?
  projectIntegration      ProjectIntegration?
  sprints                 Sprint[]
  teamVelocities          TeamVelocity[]

  // ── Scrum board (spec-literal parallel system) ──
  boardKey       String?
  scrumSprints   ScrumSprint[]
  scrumEpics     ScrumEpic[]
  scrumTasks     Task[]
  boardColumns   BoardColumn[]
  projectMembers ProjectMember[]
  teamMembers    ProjectTeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([environment])
  @@index([createdAt])
}

model ProjectCredential {
  id                String  @id @default(uuid())
  roleName          String
  username          String
  encryptedPassword String
  encryptionIv      String
  encryptionAuthTag String
  keyVersion        String  @default("v1")
  loginUrl          String?
  notes             String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  auditLogs          AuditLog[]
  testRuns           TestRun[]
  testCases          TestCase[]
  recordingSessions  RecordingSession[]
  manualTestSessions ManualTestSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([roleName])
}

model FigmaConfig {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  encryptedApiToken String?
  encryptionIv      String?
  encryptionAuthTag String?
  keyVersion        String  @default("v1")

  fileKey                String?
  nodeId                 String?
  visualTolerancePercent Float     @default(1.0)
  lastFetchedAt          DateTime?
}

model TestCase {
  id            String         @id @default(uuid())
  title         String
  priority      Priority       @default(Medium)
  preconditions String?
  source        TestCaseSource @default(Manual)
  executionType ExecutionType  @default(Manual)

  requiredCredentialId String?
  requiredCredential   ProjectCredential? @relation(fields: [requiredCredentialId], references: [id], onDelete: SetNull)

  testData Json?
  tags     String[]
  assignee String? // team-member id/name from the project's assignee pool (ProjectTeamMember)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  steps              TestStep[]
  testRuns           TestRun[]
  manualSessionCases ManualSessionCase[]
  requirements       TestCaseRequirement[]
  bugReports         BugReport[]
  scrumTaskLinks     TaskTestCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([priority])
  @@index([source])
  @@index([executionType])
}

model TestStep {
  id         String   @id @default(uuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  stepNumber        Int
  actionDescription String
  expectedResult    String

  actionType  ActionType @default(custom_instruction)
  targetType  TargetType @default(none)
  targetValue String?
  inputValue  String?
  timeoutMs   Int        @default(10000)
  assertions  Json?

  componentType       String?
  groupId             String?
  rawEvents           Json?
  actionMetadata      Json?
  locatorCandidates   Json?
  selectedOptionText  String?
  selectedOptionValue String?
  validationStatus    String?
  validationMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepResults       TestStepResult[]
  manualStepResults ManualStepResult[]

  @@index([testCaseId])
  @@index([stepNumber])
}

model TestRun {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId String?
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  status        TestRunStatus @default(Queued)
  roleUsed      String        @default("None")
  executionMode ExecutionMode @default(SelfHealing)

  browserType    BrowserType
  viewport       ViewportType
  viewportWidth  Int?
  viewportHeight Int?

  triggeredBy TestCaseSource @default(Manual)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int       @default(0)

  autonomousAgentRunId String?
  autonomousAgentRun   AutonomousAgentRun? @relation(fields: [autonomousAgentRunId], references: [id], onDelete: SetNull)
  agentBrainRunId      String?
  agentBrainRun        AgentBrainRun?      @relation(fields: [agentBrainRunId], references: [id], onDelete: SetNull)

  jobs          TestJob?
  logs          Log[]
  networkLogs   NetworkLog[]
  stepResults   TestStepResult[]
  bugReports    BugReport[]
  attachments   Attachment[]
  visualResults VisualComparisonResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([testCaseId])
  @@index([status])
  @@index([autonomousAgentRunId])
  @@index([agentBrainRunId])
  @@index([createdAt])
}

model TestJob {
  id        String  @id @default(uuid())
  testRunId String  @unique
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  status   JobStatus @default(Queued)
  attempts Int       @default(0)
  error    String?
  workerId String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
}

model TestStepResult {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepId String?
  testStep   TestStep? @relation(fields: [testStepId], references: [id], onDelete: SetNull)

  stepNumber        Int
  actionDescription String
  expectedResult    String
  actualResult      String?

  status StepStatus @default(Pending)

  screenshotBefore String?
  screenshotAfter  String?
  errorDetails     String?
  notes            String?
  durationMs       Int     @default(0)
  actionMetadata   Json?

  logs          Log[]
  networkLogs   NetworkLog[]
  visualResults VisualComparisonResult[]
  bugReports    BugReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testRunId])
  @@index([testStepId])
  @@index([status])
}

model Log {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: Cascade)

  source  LogSource
  level   LogLevel
  message String
  raw     Json?

  timestamp DateTime @default(now())

  @@index([testRunId])
  @@index([testStepResultId])
  @@index([timestamp])
}

model NetworkLog {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: Cascade)

  url          String
  method       String
  status       Int?
  error        String?
  resourceType String?
  durationMs   Int     @default(0)

  requestHeaders      Json?
  responseHeaders     Json?
  responseBodyPreview String?

  timestamp DateTime @default(now())

  @@index([testRunId])
  @@index([testStepResultId])
  @@index([timestamp])
}

model VisualComparisonResult {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  stepResultId String?
  stepResult   TestStepResult? @relation(fields: [stepResultId], references: [id], onDelete: SetNull)

  figmaImagePath  String
  actualImagePath String
  diffImagePath   String?

  mismatchPercent  Float
  tolerancePercent Float
  viewportWidth    Int
  viewportHeight   Int
  status           StepStatus

  createdAt DateTime @default(now())

  @@index([testRunId])
  @@index([stepResultId])
}

model BugReport {
  id     String  @id @default(uuid())
  bugKey String? // e.g. BUG-0001
  title  String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId String?
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  testRunId String?
  testRun   TestRun? @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  autonomousAgentRunId String?
  autonomousAgentRun   AutonomousAgentRun? @relation(fields: [autonomousAgentRunId], references: [id], onDelete: SetNull)
  agentBrainRunId      String?
  agentBrainRun        AgentBrainRun?      @relation(fields: [agentBrainRunId], references: [id], onDelete: SetNull)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: SetNull)

  severity Priority
  priority Priority
  status   BugStatus @default(Open)

  // How the bug was resolved (set when moving to Resolved/Closed/Rejected).
  resolution     BugResolution?
  resolutionNote String?

  // Free-form triage labels e.g. ["regression", "ui", "security"].
  tags String[] @default([])

  // App-side "Bug Source" (e.g. where the defect was found). Free string whose
  // dropdown options can be pulled from an OpenProject list field; stored here
  // on the bug and NOT synced to OpenProject as a custom field.
  source String?

  environment Environment?
  roleUsed    String?
  browser     BrowserType?
  viewport    ViewportType?

  assignedTo String?

  // Who filed the bug (auto-set to the creating user).
  reporterId String?
  reporter   User?   @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // OpenProject parent work package to nest this bug under when synced.
  openProjectParentId      String?
  // OpenProject board (grid id) the synced bug should be placed on.
  openProjectBoardId       String?
  // OpenProject board column (widget id) the synced bug should be placed under.
  openProjectBoardColumnId String?
  // Values for OpenProject required/custom fields on the bug type, keyed by
  // schema field key (e.g. { "customField6": { type, value } }).
  openProjectCustomFields  Json?

  stepsToReproduce String
  expectedResult   String
  actualResult     String

  screenshotPath String?
  consoleLogs    String?
  networkErrors  String?

  // Auto-captured live-session context (Testing Workstation)
  pageUrl          String?
  osInfo           String?
  screenResolution String?
  videoUrl         String?

  comments       BugComment[]
  activities     BugActivity[]
  bugAttachments BugAttachment[]

  attachments Attachment[]

  manualTestSessionId String?
  manualTestSession   ManualTestSession? @relation(fields: [manualTestSessionId], references: [id], onDelete: SetNull)

  // Live QA Session this bug was filed from (powers the Live QA History bug count).
  recordingSessionId String?
  recordingSession   RecordingSession? @relation(fields: [recordingSessionId], references: [id], onDelete: SetNull)

  requirements       BugReportRequirement[]
  scrumTaskLinks     TaskBug[]
  recordedTestCaseId String?
  recordedTestCase   RecordedTestCase?       @relation(fields: [recordedTestCaseId], references: [id], onDelete: SetNull)
  visualIssues       VisualDifferenceIssue[]
  occurrences        BugOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([testCaseId])
  @@index([testRunId])
  @@index([autonomousAgentRunId])
  @@index([agentBrainRunId])
  @@index([createdAt])
}

model Attachment {
  id String @id @default(uuid())

  testRunId String?
  testRun   TestRun? @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  bugReportId String?
  bugReport   BugReport? @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  fileType String
  fileSize Int?

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  action  String
  details String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model ElementLocator {
  id                  String             @id @default(uuid())
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  friendlyName        String
  description         String?
  pageUrl             String
  tagName             String?
  visibleText         String?
  locatorType         TargetType
  locatorValue        String
  recommendedSelector String?
  cssSelector         String?
  xpathSelector       String?
  idSelector          String?
  testIdSelector      String?
  roleSelector        String?
  textSelector        String?
  labelSelector       String?
  placeholderSelector String?
  reliabilityScore    Int                @default(0)
  attributes          Json?
  screenshotPath      String?
  isValidated         Boolean            @default(false)
  matchCount          Int?
  lastValidatedAt     DateTime?
  collectionId        String?
  collection          ElementCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  actionType          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([projectId])
  @@index([locatorType])
  @@index([collectionId])
}

model ElementCollection {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  pageUrls    String[]
  elements    ElementLocator[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId])
}

model RecordingSession {
  id                        String                 @id @default(uuid())
  projectId                 String
  project                   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialId              String?
  credential                ProjectCredential?     @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  status                    RecordingSessionStatus @default(Starting)
  browserType               BrowserType
  viewport                  ViewportType
  startUrl                  String
  currentUrl                String?
  recordingMode             String?                @default("Fast")
  currentRecordedTestCaseId String?
  connectionStatus          String?                @default("Connected")
  lastError                 String?
  keepBrowserOpen           Boolean                @default(true)
  // "Studio" (Recorder Studio) or "LiveQA" (Live QA Session)
  kind                      String                 @default("Studio")
  startedAt                 DateTime               @default(now())
  finishedAt                DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  recordedTestCases RecordedTestCase[]
  notes             RecordingSessionNote[]
  screenshots       SessionScreenshot[]
  recordings        SessionRecording[]
  bugReports        BugReport[]

  @@index([projectId, status])
}

model SessionScreenshot {
  id              String           @id @default(uuid())
  sessionId       String
  session         RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filePath        String
  fullPage        Boolean          @default(false)
  pageUrl         String?
  // Lineage: id of the raw capture this row is an annotated version of
  annotatedFromId String?
  createdAt       DateTime         @default(now())

  @@index([sessionId])
}

enum SessionRecordingStatus {
  Recording
  Ready
  Failed
}

model SessionRecording {
  id         String                 @id @default(uuid())
  sessionId  String
  session    RecordingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filePath   String?
  status     SessionRecordingStatus @default(Recording)
  startedAt  DateTime               @default(now())
  endedAt    DateTime?
  durationMs Int?
  createdAt  DateTime               @default(now())

  @@index([sessionId])
}

model RecordedTestCase {
  id                   String                 @id @default(uuid())
  sessionId            String
  session              RecordingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title                String
  module               String?                @default("General")
  moduleId             String?
  featureId            String?
  componentId          String?
  priority             Priority               @default(Medium)
  preconditions        String?
  requiredCredentialId String?
  requirementLinks     Json?
  status               RecordedTestCaseStatus @default(Draft)
  finalTestCaseId      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  savedAt              DateTime?

  steps RecordedStep[]
  bugs  BugReport[]
}

model RecordedStep {
  id                     String           @id @default(uuid())
  recordedTestCaseId     String
  recordedTestCase       RecordedTestCase @relation(fields: [recordedTestCaseId], references: [id], onDelete: Cascade)
  stepNumber             Int
  pageUrl                String
  actionType             ActionType
  actionDescription      String
  targetType             TargetType
  targetValue            String?
  inputValue             String?
  expectedResult         String?
  actualResult           String?
  notes                  String?
  assertionType          String?
  assertionValue         String?
  tagName                String?
  visibleText            String?
  recommendedSelector    String?
  cssSelector            String?
  xpathSelector          String?
  idSelector             String?
  testIdSelector         String?
  roleSelector           String?
  labelSelector          String?
  placeholderSelector    String?
  reliabilityScore       Int              @default(0)
  attributes             Json?
  alternativeLocators    Json?
  assertions             Json?
  screenshotBefore       String?
  screenshotAfter        String?
  includeInFinalTestCase Boolean          @default(true)

  componentType       String?
  groupId             String?
  rawEvents           Json?
  actionMetadata      Json?
  locatorCandidates   Json?
  selectedOptionText  String?
  selectedOptionValue String?
  validationStatus    String?
  validationMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationConfig {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider String // "jira" | "azure_devops" | "openproject"
  enabled  Boolean @default(false)

  host       String? // e.g., "jira-domain.atlassian.net"
  projectKey String? // e.g., Jira Project Key / ADO Project / OpenProject ID
  username   String? // Jira email / ADO username / OpenProject username

  encryptedToken    String?
  encryptionIv      String?
  encryptionAuthTag String?
  keyVersion        String  @default("v1")

  triggerOn String @default("Failed") // "Failed" | "All"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Feature — hierarchy layer between Epic and User Story ──────────────────
model Feature {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epicId       String?
  epic         Epic?         @relation(fields: [epicId], references: [id], onDelete: SetNull)
  featureKey   String
  name         String
  description  String?
  orderIndex   Int           @default(0)
  requirements Requirement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, featureKey])
  @@index([projectId])
  @@index([epicId])
}

model ReusableStepFlow {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String?

  steps ReusableStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReusableStep {
  id String @id @default(uuid())

  flowId String
  flow   ReusableStepFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  stepNumber        Int
  actionDescription String
  expectedResult    String?

  actionType  ActionType
  targetType  TargetType
  targetValue String?
  inputValue  String?
  assertions  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestDataVariable {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key               String
  value             String?
  encryptedValue    String?
  encryptionIv      String?
  encryptionAuthTag String?
  keyVersion        String?

  dataType    String       @default("text") // text, number, boolean, date, json, secret
  environment Environment?
  isSensitive Boolean      @default(false)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

model ManualTestSession {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name   String
  status String @default("Active") // Active, Completed, Cancelled

  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  environment Environment
  browserType BrowserType
  viewport    ViewportType

  keepBrowserSession Boolean @default(true)
  stopOnFailure      Boolean @default(false)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int       @default(0)

  sessionCases ManualSessionCase[]
  notes        ManualSessionNote[]
  bugs         BugReport[]
}

model ManualSessionCase {
  id String @id @default(uuid())

  sessionId String
  session   ManualTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  orderIndex Int        @default(0)
  status     StepStatus @default(Pending)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int       @default(0)

  stepResults ManualStepResult[]
}

model ManualStepResult {
  id String @id @default(uuid())

  sessionCaseId String
  sessionCase   ManualSessionCase @relation(fields: [sessionCaseId], references: [id], onDelete: Cascade)

  testStepId String?
  testStep   TestStep? @relation(fields: [testStepId], references: [id], onDelete: SetNull)

  stepNumber        Int
  actionDescription String
  expectedResult    String?
  actualResult      String?

  status StepStatus @default(Pending)
  notes  String?

  screenshotPath String?
  bugReportId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManualSessionNote {
  id String @id @default(uuid())

  sessionId String
  session   ManualTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  note           String
  screenshotPath String?
  pageUrl        String?

  createdAt DateTime @default(now())
}

// ─── Epic — hierarchy layer above Requirement (user story) ──────────────────
// Orthogonal to the Module/Feature/Component tree by design.
enum EpicStatus {
  Draft
  Active
  Completed
  Archived
}

// Scrum board: a sprint groups Requirements(Stories) for a time-box.
enum SprintStatus {
  Future
  Active
  Completed
}

model Sprint {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  goal         String?
  status       SprintStatus  @default(Future)
  startDate    DateTime?
  endDate      DateTime?
  orderIndex   Int           @default(0)
  completedAt  DateTime?
  requirements Requirement[]
  metrics      SprintMetric[]
  velocities   TeamVelocity[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
}

// Daily snapshot of a sprint's burndown / throughput, for analytics. Optional —
// analytics endpoints derive live from Requirements when no snapshots exist, but
// these rows let a scheduled job persist an exact historical series.
model SprintMetric {
  id                   String   @id @default(cuid())
  sprintId             String
  sprint               Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  date                 DateTime @db.Date
  storyPointsCommitted Int
  storyPointsCompleted Int
  tasksCreated         Int
  tasksCompleted       Int
  bugsFound            Int
  bugsResolved         Int
  createdAt            DateTime @default(now())

  @@unique([sprintId, date])
  @@index([sprintId])
}

// Per-sprint velocity vs capacity snapshot for the velocity chart.
model TeamVelocity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId  String
  sprint    Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  velocity  Int      // story points completed
  capacity  Int      // team capacity in story points
  createdAt DateTime @default(now())

  @@unique([sprintId])
  @@index([projectId])
}

model Epic {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epicKey      String
  title        String
  description  String?
  priority     Priority      @default(Medium)
  status       EpicStatus    @default(Active)
  orderIndex   Int           @default(0)
  requirements Requirement[]
  features     Feature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, epicKey])
  @@index([projectId])
}

model Requirement {
  id                 String                 @id @default(uuid())
  projectId          String
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting an Epic never deletes stories at the DB level — SetNull orphans
  // them; cascade delete of children is an explicit app-side choice.
  epicId             String?
  epic               Epic?                  @relation(fields: [epicId], references: [id], onDelete: SetNull)
  requirementKey     String
  title              String
  description        String?
  acceptanceCriteria String?
  priority           Priority               @default(Medium)
  status             RequirementStatus      @default(Draft)
  source             RequirementSource      @default(Manual)
  // Ordering position in the product backlog view (lower = higher priority).
  backlogRank        Int?
  // Scrum board fields (Story = Requirement)
  storyPoints        Int?
  assignee           String? // free-text name/email for Phase 1
  labels             String[]
  sprintId           String?
  sprint             Sprint?                @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  // Rank within a sprint / backlog column (lower = higher). Distinct from backlogRank.
  boardRank          Int?
  // Optional middle layer: assigning a feature auto-aligns epicId app-side
  featureId          String?
  feature            Feature?               @relation(fields: [featureId], references: [id], onDelete: SetNull)
  // Hierarchy: a Task/Bug hangs off a parent Story (Epic → Story → Task/Bug).
  parentId           String?
  parent             Requirement?           @relation("RequirementChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Requirement[]          @relation("RequirementChildren")
  figmaUrl           String?
  externalUrl        String?
  externalSystem     String? // Jira, Azure DevOps, GitHub, Manual, Other
  testCases          TestCaseRequirement[]
  bugReports         BugReportRequirement[]
  subtasks           RequirementSubtask[]
  dueDate            DateTime?
  timeEstimate       Int?
  timeSpent          Int?
  comments           RequirementComment[]
  sourceImportId     String?
  sourceImport       RequirementImport?     @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  sourceLocation     Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([projectId, requirementKey])
  @@index([projectId])
  @@index([epicId])
  @@index([status])
  @@index([featureId])
  @@index([sprintId])
  @@index([parentId])
}

model RequirementComment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  author        String
  content       String
  createdAt     DateTime    @default(now())

  @@index([requirementId])
}

enum RequirementImportStatus {
  Uploaded
  Parsed
  Generated
  Saved
  Failed
}

model RequirementImport {
  id           String                  @id @default(uuid())
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  language     String?
  status       RequirementImportStatus @default(Parsed)
  rawText      String?
  parsedItems  Json? // Array of normalized requirement items
  summary      Json? // Parsing/generation summary metadata
  requirements Requirement[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([projectId])
}

model TestCaseRequirement {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCaseId    String
  testCase      TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([requirementId, testCaseId])
}

// Lightweight checklist items under a story (Jira-style sub-tasks).
model RequirementSubtask {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  title         String
  done          Boolean     @default(false)
  assignee      String?
  orderIndex    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([requirementId])
}

// ─── External sync mapping (TestCase / BugReport ↔ OpenProject work package) ─
enum ExternalProvider {
  OpenProject
  Jira
  AzureDevOps
  ClickUp
}

model ExternalSyncMapping {
  id        String @id @default(uuid())
  projectId String

  provider        ExternalProvider
  localEntityType String // "TestCase" | "BugReport"
  localEntityId   String

  externalId   String // OpenProject work package ID (numeric as string)
  externalUrl  String? // Direct URL to the work package
  externalType String? // work package type name

  lastSyncedAt   DateTime?
  lastSyncStatus String? // "success" | "failed" | "pending"
  lastSyncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, localEntityType, localEntityId])
  @@index([projectId])
  @@index([localEntityId])
}

// ─── Bug occurrence — re-run of same failure links here instead of new bug ───
model BugOccurrence {
  id          String    @id @default(uuid())
  bugReportId String
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  testRunId   String
  occurredAt  DateTime  @default(now())
  evidence    Json? // screenshot paths, error details snapshot

  @@index([bugReportId])
}

model BugReportRequirement {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  bugReportId   String
  bugReport     BugReport   @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([requirementId, bugReportId])
}

enum BugStatus {
  Open
  InProgress
  ReadyForRetest
  Reopened
  Resolved
  Closed
  Rejected
  Duplicate
}

enum BugResolution {
  Fixed
  WontFix
  CannotReproduce
  Duplicate
  ByDesign
}

model BugComment {
  id        String    @id @default(uuid())
  bugId     String
  bug       BugReport @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId  String?
  comment   String
  createdAt DateTime  @default(now())
}

model BugActivity {
  id        String    @id @default(uuid())
  bugId     String
  bug       BugReport @relation(fields: [bugId], references: [id], onDelete: Cascade)
  action    String
  details   String?
