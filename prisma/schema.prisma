datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Environment {
  Dev
  Staging
  UAT
  Production
}

enum BrowserType {
  Chromium
  Firefox
  WebKit
}

enum ViewportType {
  Desktop
  Tablet
  Mobile
  Custom
}

enum TestType {
  Functional
  VisualDesign
  E2E
  Regression
  Smoke
  Exploratory
}

enum Priority {
  Low
  Medium
  High
  Critical
}

enum RequirementStatus {
  Draft
  ReadyForTesting
  InTesting
  Covered
  PartiallyCovered
  Failed
  Blocked
  Deprecated
}

enum RequirementSource {
  Manual
  ExcelImport
  Jira
  AzureDevOps
  GitHub
  Figma
  AIGenerated
  OpenProject
}

enum TestRunStatus {
  Queued
  Running
  Passed
  Failed
  Blocked
  Warning
  Cancelled
}

enum StepStatus {
  Pending
  Running
  Passed
  Failed
  Blocked
  Warning
  Skipped
  SelfHealed
}

enum ExecutionMode {
  Normal
  SelfHealing
  Debug
}

enum ExecutionType {
  Manual
  Automated
}

enum TestCaseSource {
  Manual
  AIGenerated
  Imported
  Exploratory
  Recorder
  QAAgentBrain
  RequirementFile
}

enum ActionType {
  open_url
  click
  fill
  select
  select_custom
  select_searchable
  multi_select
  remove_multi_select_value
  autocomplete_select
  date_select
  time_select
  upload_file
  check
  uncheck
  radio_select
  tab_select
  menu_select
  modal_open
  modal_close
  table_row_select
  pagination_next
  pagination_previous
  accordion_expand
  accordion_collapse
  toggle_on
  toggle_off
  slider_set
  wait_for_text
  wait_for_url
  assert_visible
  assert_hidden
  assert_text
  assert_url
  assert_api_status
  screenshot
  custom_instruction
  visible
  hidden
  text_contains
  text_equals
  value_equals
  url_equals
  url_contains
  title_contains
  wait
  note
}

enum TargetType {
  test_id
  role
  text
  label
  placeholder
  css
  xpath
  url
  none
}

enum LogLevel {
  info
  warning
  error
  debug
}

enum LogSource {
  browser
  server
  playwright
  ai
  network
}

enum JobStatus {
  Queued
  Running
  Completed
  Failed
  Cancelled
}

enum UserPlan {
  Free
  Pro
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  plan         UserPlan   @default(Free)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projects     Project[]
  auditLogs    AuditLog[]
  reportedBugs BugReport[] @relation("BugReporter")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  webAppUrl   String
  figmaUrl    String?
  description String?
  environment Environment  @default(Staging)
  browserType BrowserType  @default(Chromium)
  viewport    ViewportType @default(Desktop)
  testType    TestType     @default(Functional)
  status      ProjectStatus @default(Active)

  customViewportWidth  Int?
  customViewportHeight Int?

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentials ProjectCredential[]
  figmaConfig FigmaConfig?
  integrationConfig IntegrationConfig?
  testCases   TestCase[]
  testRuns    TestRun[]
  auditLogs   AuditLog[]
  elementLocators ElementLocator[]
  elementCollections ElementCollection[]
  recordingSessions RecordingSession[]
  modules     ProjectModule[]
  features    ProjectFeature[]
  components  ProjectComponent[]

  manualTestSessions ManualTestSession[]
  reusableStepFlows   ReusableStepFlow[]
  testDataVariables   TestDataVariable[]
  requirements        Requirement[]
  epics               Epic[]
  requirementImports  RequirementImport[]
  bugReports          BugReport[]
  figmaFrames             FigmaFrame[]
  visualCheckMappings     VisualCheckMapping[]
  visualToleranceProfiles VisualToleranceProfile[]
  visualCheckRuns         VisualCheckRun[]
  autonomousAgentRuns     AutonomousAgentRun[]
  agentBrainRuns          AgentBrainRun[]
  agentMemories           AgentMemory[]
  qaAgentRuns             QAAgentRun[]
  openProjectIntegration  OpenProjectIntegration?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([environment])
  @@index([createdAt])
}

model ProjectCredential {
  id                String   @id @default(uuid())
  roleName          String
  username          String
  encryptedPassword String
  encryptionIv      String
  encryptionAuthTag String
  keyVersion        String   @default("v1")
  loginUrl          String?
  notes             String?

  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  auditLogs         AuditLog[]
  testRuns          TestRun[]
  testCases         TestCase[]
  recordingSessions RecordingSession[]
  manualTestSessions ManualTestSession[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([roleName])
}

model FigmaConfig {
  id                      String   @id @default(uuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  encryptedApiToken       String?
  encryptionIv            String?
  encryptionAuthTag       String?
  keyVersion              String   @default("v1")

  fileKey                 String?
  nodeId                  String?
  visualTolerancePercent  Float    @default(1.0)
  lastFetchedAt           DateTime?
}

model TestCase {
  id              String          @id @default(uuid())
  title           String
  module          String?
  priority        Priority        @default(Medium)
  preconditions   String?
  source          TestCaseSource  @default(Manual)
  executionType   ExecutionType   @default(Manual)

  moduleId        String?
  moduleRelation  ProjectModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  featureId       String?
  feature         ProjectFeature?  @relation(fields: [featureId], references: [id], onDelete: SetNull)
  componentId     String?
  component       ProjectComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  requiredCredentialId String?
  requiredCredential   ProjectCredential? @relation(fields: [requiredCredentialId], references: [id], onDelete: SetNull)

  testData        Json?
  tags            String[]

  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  steps           TestStep[]
  testRuns        TestRun[]
  manualSessionCases ManualSessionCase[]
  requirements    TestCaseRequirement[]
  bugReports      BugReport[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([projectId])
  @@index([moduleId])
  @@index([featureId])
  @@index([componentId])
  @@index([priority])
  @@index([source])
  @@index([executionType])
}

model TestStep {
  id                String      @id @default(uuid())
  testCaseId        String
  testCase          TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  stepNumber        Int
  actionDescription String
  expectedResult    String

  actionType        ActionType  @default(custom_instruction)
  targetType        TargetType  @default(none)
  targetValue       String?
  inputValue        String?
  timeoutMs         Int         @default(10000)
  assertions        Json?

  componentType       String?
  groupId             String?
  rawEvents           Json?
  actionMetadata      Json?
  locatorCandidates   Json?
  selectedOptionText  String?
  selectedOptionValue String?
  validationStatus    String?
  validationMessage   String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  stepResults       TestStepResult[]
  manualStepResults ManualStepResult[]

  @@index([testCaseId])
  @@index([stepNumber])
}

model TestRun {
  id            String             @id @default(uuid())

  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId    String?
  testCase      TestCase?          @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  credentialId  String?
  credential    ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  status        TestRunStatus      @default(Queued)
  roleUsed      String             @default("None")
  executionMode ExecutionMode      @default(SelfHealing)

  browserType   BrowserType
  viewport      ViewportType
  viewportWidth Int?
  viewportHeight Int?

  triggeredBy   TestCaseSource     @default(Manual)

  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int                @default(0)

  autonomousAgentRunId String?
  autonomousAgentRun   AutonomousAgentRun? @relation(fields: [autonomousAgentRunId], references: [id], onDelete: SetNull)
  agentBrainRunId      String?
  agentBrainRun        AgentBrainRun?      @relation(fields: [agentBrainRunId], references: [id], onDelete: SetNull)

  jobs          TestJob?
  logs          Log[]
  networkLogs   NetworkLog[]
  stepResults   TestStepResult[]
  bugReports    BugReport[]
  attachments   Attachment[]
  visualResults VisualComparisonResult[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([projectId])
  @@index([testCaseId])
  @@index([status])
  @@index([autonomousAgentRunId])
  @@index([agentBrainRunId])
  @@index([createdAt])
}

model TestJob {
  id          String    @id @default(uuid())
  testRunId   String    @unique
  testRun     TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  status      JobStatus @default(Queued)
  attempts    Int       @default(0)
  error       String?
  workerId    String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
}

model TestStepResult {
  id                String      @id @default(uuid())

  testRunId         String
  testRun           TestRun     @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepId        String?
  testStep          TestStep?   @relation(fields: [testStepId], references: [id], onDelete: SetNull)

  stepNumber        Int
  actionDescription String
  expectedResult    String
  actualResult      String?

  status            StepStatus  @default(Pending)

  screenshotBefore  String?
  screenshotAfter   String?
  errorDetails      String?
  notes             String?
  durationMs        Int         @default(0)
  actionMetadata    Json?

  logs              Log[]
  networkLogs       NetworkLog[]
  visualResults     VisualComparisonResult[]
  bugReports        BugReport[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([testRunId])
  @@index([testStepId])
  @@index([status])
}

model Log {
  id               String          @id @default(uuid())

  testRunId        String
  testRun          TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: Cascade)

  source           LogSource
  level            LogLevel
  message          String
  raw              Json?

  timestamp        DateTime        @default(now())

  @@index([testRunId])
  @@index([testStepResultId])
  @@index([timestamp])
}

model NetworkLog {
  id               String          @id @default(uuid())

  testRunId        String
  testRun          TestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: Cascade)

  url              String
  method           String
  status           Int?
  error            String?
  resourceType     String?
  durationMs       Int             @default(0)

  requestHeaders   Json?
  responseHeaders  Json?
  responseBodyPreview String?

  timestamp        DateTime        @default(now())

  @@index([testRunId])
  @@index([testStepResultId])
  @@index([timestamp])
}

model VisualComparisonResult {
  id               String      @id @default(uuid())

  testRunId        String
  testRun          TestRun     @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  stepResultId     String?
  stepResult       TestStepResult? @relation(fields: [stepResultId], references: [id], onDelete: SetNull)

  figmaImagePath   String
  actualImagePath  String
  diffImagePath    String?

  mismatchPercent  Float
  tolerancePercent Float
  viewportWidth    Int
  viewportHeight   Int
  status           StepStatus

  createdAt        DateTime    @default(now())

  @@index([testRunId])
  @@index([stepResultId])
}

model BugReport {
  id               String       @id @default(uuid())
  bugKey           String?      // e.g. BUG-0001
  title            String

  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  moduleId         String?
  moduleRelation   ProjectModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  featureId        String?
  feature          ProjectFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  componentId      String?
  component        ProjectComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  testCaseId       String?
  testCase         TestCase?    @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  testRunId        String?
  testRun          TestRun?     @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  autonomousAgentRunId String?
  autonomousAgentRun   AutonomousAgentRun? @relation(fields: [autonomousAgentRunId], references: [id], onDelete: SetNull)
  agentBrainRunId      String?
  agentBrainRun        AgentBrainRun?      @relation(fields: [agentBrainRunId], references: [id], onDelete: SetNull)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: SetNull)

  severity         Priority
  priority         Priority
  status           BugStatus    @default(Open)

  // How the bug was resolved (set when moving to Resolved/Closed/Rejected).
  resolution       BugResolution?
  resolutionNote   String?

  // Free-form triage labels e.g. ["regression", "ui", "security"].
  tags             String[]     @default([])

  environment      Environment?
  roleUsed         String?
  browser          BrowserType?
  viewport         ViewportType?

  assignedTo       String?

  // Who filed the bug (auto-set to the creating user).
  reporterId       String?
  reporter         User?        @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // OpenProject parent work package to nest this bug under when synced.
  openProjectParentId String?
  // OpenProject board (grid id) the synced bug should be placed on.
  openProjectBoardId  String?
  // OpenProject board column (widget id) the synced bug should be placed under.
  openProjectBoardColumnId String?
  // Values for OpenProject required/custom fields on the bug type, keyed by
  // schema field key (e.g. { "customField6": { type, value } }).
  openProjectCustomFields Json?

  stepsToReproduce String
  expectedResult   String
  actualResult     String

  screenshotPath   String?
  consoleLogs      String?
  networkErrors    String?

  // Auto-captured live-session context (Testing Workstation)
  pageUrl          String?
  osInfo           String?
  screenResolution String?
  videoUrl         String?

  comments         BugComment[]
  activities       BugActivity[]
  bugAttachments   BugAttachment[]

  attachments      Attachment[]

  manualTestSessionId String?
  manualTestSession   ManualTestSession? @relation(fields: [manualTestSessionId], references: [id], onDelete: SetNull)
  requirements        BugReportRequirement[]
  recordedTestCaseId  String?
  recordedTestCase    RecordedTestCase?  @relation(fields: [recordedTestCaseId], references: [id], onDelete: SetNull)
  visualIssues        VisualDifferenceIssue[]
  occurrences         BugOccurrence[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([testCaseId])
  @@index([testRunId])
  @@index([autonomousAgentRunId])
  @@index([agentBrainRunId])
  @@index([createdAt])
}

model Attachment {
  id          String     @id @default(uuid())

  testRunId   String?
  testRun     TestRun?   @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  bugReportId String?
  bugReport   BugReport? @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  fileName    String
  filePath    String
  fileType    String
  fileSize    Int?

  createdAt   DateTime   @default(now())
}

model AuditLog {
  id           String             @id @default(uuid())

  action       String
  details      String

  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  createdAt    DateTime           @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model ElementLocator {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId            String?
  moduleRelation      ProjectModule?    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  featureId           String?
  feature             ProjectFeature?   @relation(fields: [featureId], references: [id], onDelete: SetNull)
  componentId         String?
  component           ProjectComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  friendlyName        String
  description         String?
  pageUrl             String
  tagName             String?
  visibleText         String?
  locatorType         TargetType
  locatorValue        String
  recommendedSelector String?
  cssSelector         String?
  xpathSelector       String?
  idSelector          String?
  testIdSelector      String?
  roleSelector        String?
  textSelector        String?
  labelSelector       String?
  placeholderSelector String?
  reliabilityScore    Int               @default(0)
  attributes          Json?
  screenshotPath      String?
  isValidated         Boolean           @default(false)
  matchCount          Int?
  lastValidatedAt     DateTime?
  collectionId        String?
  collection          ElementCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  actionType          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([projectId])
  @@index([moduleId])
  @@index([featureId])
  @@index([componentId])
  @@index([locatorType])
  @@index([collectionId])
}

model ElementCollection {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  pageUrls    String[]
  elements    ElementLocator[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId])
}

model RecordingSession {
  id           String             @id @default(uuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  status       RecordingSessionStatus @default(Starting)
  browserType  BrowserType
  viewport     ViewportType
  startUrl     String
  currentUrl   String?
  recordingMode String?           @default("Fast")
  currentRecordedTestCaseId String?
  connectionStatus String?       @default("Connected")
  lastError    String?
  keepBrowserOpen Boolean         @default(true)
  // "Studio" (Recorder Studio) or "LiveQA" (Live QA Session)
  kind         String             @default("Studio")
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  recordedTestCases RecordedTestCase[]
  notes             RecordingSessionNote[]
  screenshots       SessionScreenshot[]
  recordings        SessionRecording[]

  @@index([projectId, status])
}

model SessionScreenshot {
  id              String           @id @default(uuid())
  sessionId       String
  session         RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filePath        String
  fullPage        Boolean          @default(false)
  pageUrl         String?
  // Lineage: id of the raw capture this row is an annotated version of
  annotatedFromId String?
  createdAt       DateTime         @default(now())

  @@index([sessionId])
}

enum SessionRecordingStatus {
  Recording
  Ready
  Failed
}

model SessionRecording {
  id         String                 @id @default(uuid())
  sessionId  String
  session    RecordingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filePath   String?
  status     SessionRecordingStatus @default(Recording)
  startedAt  DateTime               @default(now())
  endedAt    DateTime?
  durationMs Int?
  createdAt  DateTime               @default(now())

  @@index([sessionId])
}

model RecordedTestCase {
  id                   String            @id @default(uuid())
  sessionId            String
  session              RecordingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title                String
  module               String?           @default("General")
  moduleId             String?
  featureId            String?
  componentId          String?
  priority             Priority          @default(Medium)
  preconditions        String?
  requiredCredentialId String?
  requirementLinks     Json?
  status               RecordedTestCaseStatus @default(Draft)
  finalTestCaseId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  savedAt              DateTime?

  steps                RecordedStep[]
  bugs                 BugReport[]
}

model RecordedStep {
  id                  String           @id @default(uuid())
  recordedTestCaseId  String
  recordedTestCase    RecordedTestCase @relation(fields: [recordedTestCaseId], references: [id], onDelete: Cascade)
  stepNumber          Int
  pageUrl             String
  actionType          ActionType
  actionDescription   String
  targetType          TargetType
  targetValue         String?
  inputValue          String?
  expectedResult      String?
  actualResult        String?
  notes               String?
  assertionType       String?
  assertionValue      String?
  tagName             String?
  visibleText         String?
  recommendedSelector String?
  cssSelector         String?
  xpathSelector       String?
  idSelector          String?
  testIdSelector      String?
  roleSelector        String?
  labelSelector       String?
  placeholderSelector String?
  reliabilityScore    Int              @default(0)
  attributes          Json?
  alternativeLocators Json?
  assertions          Json?
  screenshotBefore    String?
  screenshotAfter     String?
  includeInFinalTestCase Boolean       @default(true)

  componentType       String?
  groupId             String?
  rawEvents           Json?
  actionMetadata      Json?
  locatorCandidates   Json?
  selectedOptionText  String?
  selectedOptionValue String?
  validationStatus    String?
  validationMessage   String?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model IntegrationConfig {
  id                String   @id @default(uuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider          String   // "jira" | "azure_devops" | "openproject"
  enabled           Boolean  @default(false)

  host              String?  // e.g., "jira-domain.atlassian.net"
  projectKey        String?  // e.g., Jira Project Key / ADO Project / OpenProject ID
  username          String?  // Jira email / ADO username / OpenProject username

  encryptedToken    String?
  encryptionIv      String?
  encryptionAuthTag String?
  keyVersion        String   @default("v1")

  triggerOn         String   @default("Failed") // "Failed" | "All"

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProjectModule {
  id              String           @id @default(uuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  orderIndex      Int              @default(0)

  features        ProjectFeature[]
  components      ProjectComponent[]
  testCases       TestCase[]
  elementLocators ElementLocator[]
  requirements    Requirement[]
  bugReports      BugReport[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProjectFeature {
  id              String           @id @default(uuid())
  moduleId        String
  module          ProjectModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  orderIndex      Int              @default(0)

  components      ProjectComponent[]
  testCases       TestCase[]
  elementLocators ElementLocator[]
  requirements    Requirement[]
  bugReports      BugReport[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProjectComponent {
  id              String         @id @default(uuid())
  featureId       String
  feature         ProjectFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  moduleId        String
  module          ProjectModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  orderIndex      Int            @default(0)

