  bugReports BugReport[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

enum QAAgentMode {
  Guided
  SemiAutonomous
  Autonomous
}

enum QAAgentRunStatus {
  Queued
  Scanning
  Planning
  WaitingForApproval
  Running
  Reporting
  Completed
  Failed
  Cancelled
}

enum QAAgentSafetyLevel {
  ReadOnly
  AllowFormFill
  AllowCreateUpdate
  AllowDestructiveWithConfirmation
}

enum QAAgentFindingType {
  TestFailure
  BrokenElement
  MissingValidation
  ConsoleError
  NetworkError
  AccessibilityIssue
  CoverageGap
  LocatorHealed
  Risk
}

model QAAgentRun {
