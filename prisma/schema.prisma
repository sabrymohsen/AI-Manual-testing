// ─── Epic — hierarchy layer above Requirement (user story) ──────────────────
// Orthogonal to the Module/Feature/Component tree by design.
enum EpicStatus {
  Draft
  Active
  Completed
  Archived
}

model Epic {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epicKey      String
  title        String
  description  String?
  priority     Priority      @default(Medium)
  status       EpicStatus    @default(Active)
  orderIndex   Int           @default(0)
  requirements Requirement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, epicKey])
  @@index([projectId])
}

model Requirement {
  id              String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting an Epic never deletes stories at the DB level — SetNull orphans
  // them; cascade delete of children is an explicit app-side choice.
  epicId           String?
  epic             Epic?    @relation(fields: [epicId], references: [id], onDelete: SetNull)
  requirementKey   String
  title            String
  description      String?
  acceptanceCriteria String?
  priority         Priority @default(Medium)
  status           RequirementStatus @default(Draft)
  source           RequirementSource @default(Manual)
  // Ordering position in the product backlog view (lower = higher priority).
  backlogRank      Int?
  moduleId         String?
  module           ProjectModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  featureId        String?
  feature          ProjectFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  componentId      String?
  component        ProjectComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  figmaUrl         String?
  externalUrl      String?
  externalSystem   String? // Jira, Azure DevOps, GitHub, Manual, Other
  testCases        TestCaseRequirement[]
  bugReports       BugReportRequirement[]
  sourceImportId   String?
  sourceImport     RequirementImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  sourceLocation   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, requirementKey])
  @@index([projectId])
  @@index([epicId])
  @@index([status])
  @@index([moduleId])
  @@index([featureId])
  @@index([componentId])
}

enum RequirementImportStatus {
  Uploaded
  Parsed
  Generated
  Saved
  Failed
}

model RequirementImport {
  id           String                  @id @default(uuid())
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  language     String?
  status       RequirementImportStatus @default(Parsed)
  rawText      String?
  parsedItems  Json?                   // Array of normalized requirement items
  summary      Json?                   // Parsing/generation summary metadata
  requirements Requirement[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([projectId])
}

model TestCaseRequirement {
  id             String      @id @default(uuid())
  requirementId  String
  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
