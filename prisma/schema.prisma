model QAAgentRunStep {
  id             String     @id @default(uuid())
  agentRunId     String
  agentRun       QAAgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  stepNumber     Int
  phase          String?
  name           String
  type           String
  status         String
  message        String?
  details        Json?
  screenshotPath String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model QAAgentFinding {
  id             String             @id @default(uuid())
  agentRunId     String
  agentRun       QAAgentRun         @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  type           QAAgentFindingType
  severity       Priority           @default(Medium)
  title          String
  description    String?
  evidence       Json?
  screenshotPath String?
  bugReportId    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model QAAgentRunEvent {
  id         String     @id @default(uuid())
  agentRunId String
  agentRun   QAAgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  level      String
  phase      String?
  message    String
  details    Json?
  createdAt  DateTime   @default(now())

  @@index([agentRunId])
}

// ─── Unified project-management integration (Jira/Azure DevOps/ClickUp/OpenProject) ─
// Provider-agnostic replacement for the per-provider config. The connected tool is
// chosen per project; provider-specific settings live in JSON columns, while the
// connection/auth/toggles are typed. Reconciled against the WorkItemProvider
// abstraction in src/lib/integrations/core.

enum IntegrationProvider {
  OpenProject
  Jira
  AzureDevOps
  ClickUp
}

model ProjectIntegration {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider IntegrationProvider
  enabled  Boolean             @default(true)

  baseUrl            String
  // OP slug | Jira project key | ADO project | ClickUp list id
  externalProjectKey String
  username           String? // Jira account email / etc. (token-only providers leave null)

  // Encrypted API token / PAT / personal token (AES-256-GCM, src/lib/crypto)
  apiTokenEncrypted  String
  apiTokenIv         String
  apiTokenAuthTag    String
  apiTokenKeyVersion String @default("v1")

  // Provider-agnostic mapping config (see src/lib/integrations/core/types)
  typeMapping        Json? // { testCase, bug, userStory } -> external type id
  statusMapping      Json? // local status -> external status/state id
  boardConfig        Json? // { strategy, boardId, columnId, versionId, assigneeId }
  parentConfig       Json? // { strategy, defaultParentId }
  customFieldMapping Json?

  // Auto-sync toggles (parity with the legacy OpenProject flags)
  autoSyncTestCases      Boolean @default(false)
  autoSyncResults        Boolean @default(true)
  autoCreateBugOnFailure Boolean @default(true)
  autoSyncBugToTracker   Boolean @default(false)

  // Two-way (inbound) sync
  inboundSyncEnabled Boolean   @default(false)
  webhookSecret      String?
  externalWebhookId  String? // id of the webhook/service-hook we registered, for cleanup
  lastInboundAt      DateTime?

  // Monitoring
  lastConnectionStatus    String?
  lastConnectionCheckedAt DateTime?
  lastSyncAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

// ─── OpenProject Integration ─────────────────────────────────────────────────

enum OpenProjectParentStrategy {
  None
  SingleParent
  ByModule
  ByFeature
  ByRequirement
  ByTestSuite
}

enum OpenProjectBoardStrategy {
  StatusBased
  ParentChildBased
  TypeBased
  VersionBased
  CustomFieldBased
}

model OpenProjectIntegration {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  baseUrl                      String
  openProjectProjectIdentifier String

  // Encrypted API token (AES-256-GCM)
  apiTokenEncrypted  String
  apiTokenIv         String
  apiTokenAuthTag    String
  apiTokenKeyVersion String @default("v1")

  // Type mapping (IDs loaded dynamically from OpenProject)
  testCaseTypeId  String?
  bugTypeId       String?
  userStoryTypeId String?

  // Status mapping (local status → OpenProject status ID)
  defaultStatusId     String?
  notExecutedStatusId String?
  runningStatusId     String?
  passedStatusId      String?
  failedStatusId      String?
  blockedStatusId     String?

  // Parent strategy
  parentStrategy             OpenProjectParentStrategy @default(None)
  defaultParentWorkPackageId String?

  // Board strategy
  boardStrategy        OpenProjectBoardStrategy @default(StatusBased)
  targetBoardId        String?
  targetColumnStatusId String? // status ID of the board column to place WPs in
  targetVersionId      String?
  targetAssigneeId     String?
  customFieldMapping   Json?

  // Auto-sync toggles
  autoSyncTestCases        Boolean @default(false)
  autoSyncResults          Boolean @default(true)
  autoCreateBugOnFailure   Boolean @default(true)
  autoSyncBugToOpenProject Boolean @default(false)

  // Monitoring
  lastConnectionStatus    String?
  lastConnectionCheckedAt DateTime?
  lastSyncAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpenProjectParentMapping {
  id              String  @id @default(uuid())
  projectId       String
  mappingType     String // "Module" | "Feature" | "Requirement" | "TestSuite"
  localEntityId   String
  localEntityName String?

  openProjectParentId      String
  openProjectParentSubject String?
  openProjectParentUrl     String?

  validationStatus String? // "valid" | "invalid" | "unchecked"
  lastValidatedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, mappingType, localEntityId])
  @@index([projectId])
}

model OpenProjectSyncRun {
  id        String @id @default(uuid())
  projectId String
  operation String // "bulk-sync-test-cases" | "apply-parent" | "sync-to-board" | "check-board" | etc.
  status    String // "Queued" | "Running" | "Completed" | "Failed"

  totalCount   Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)
  skippedCount Int @default(0)
  failedCount  Int @default(0)

  details Json? // Array of per-item results
  error   String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ─── Per-feature OpenProject config ──────────────────────────────────────────
// Each feature can override (or inherit) the project-level OpenProjectIntegration.
// null fields mean "inherit from project config".
// featureId is a Feature.id UUID or the literal string "unassigned".

model OpenProjectFeatureConfig {
  id        String @id @default(uuid())
  projectId String
  featureId String // Feature.id | "unassigned"

  // Connection overrides (null = inherit from OpenProjectIntegration)
  baseUrl                      String?
  openProjectProjectIdentifier String?

  // Encrypted API token override (null = inherit from project token)
  apiTokenEncrypted  String?
  apiTokenIv         String?
  apiTokenAuthTag    String?
  apiTokenKeyVersion String  @default("v1")

  // Type mapping override
  testCaseTypeId String?

  // Status mapping overrides (null = inherit from project config)
  passedStatusId  String?
  failedStatusId  String?
  blockedStatusId String?
  defaultStatusId String?

  // Board & version targeting (null = inherit from project config)
  targetBoardId        String?
  targetBoardType      String? // "status" | "version" | "assignee" | "basic"
  targetColumnStatusId String? // status ID of the board column to place WPs in
  targetVersionId      String?

  // Last sync outcome for this feature
  lastSyncAt     DateTime?
  lastSyncStatus String? // "success" | "failed"
  lastSyncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, featureId])
  @@index([projectId])
}

model TestScript {
  id                   String          @id @default(uuid())
  name                 String
  type                 String // "Web" | "API" | "Database"
  code                 String          @db.Text
  tags                 String[]
  accessibilityEnabled Boolean         @default(false) // run WCAG audit on execution (Section 1b)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  executions           TestExecution[]
}

model TestExecution {
  id              String     @id @default(uuid())
  scriptId        String
  script          TestScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  status          String // "Passed" | "Failed" | "Running"
  logOutput       String     @db.Text
  allureLink      String?
  browser         String? // "Chrome" | "Firefox" | "Edge" | "Headless"
  duration        Int? // execution duration in milliseconds
  screenshotPath  String? // absolute path of the captured screenshot evidence
  executionTarget String? // name of the execution target it ran on (Section 1c), null = Local
  createdAt       DateTime   @default(now())
}

// Section 1a: external SHAFT test data files (data-driven testing)
model TestDataFile {
  id              String   @id @default(uuid())
  name            String // display name, e.g. "loginUsers"
  fileName        String   @unique // on-disk name, e.g. "loginUsers.json"
  filePath        String // absolute path under src/test/resources/testDataFiles/
  content         String   @db.Text // JSON content — DB is source of truth, mirrored to disk
  jsonSchema      Json? // optional field definitions produced by the Create Data Set wizard
  linkedScriptIds String[] // TestScript ids this data file feeds (1:N)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Section 1b: WCAG accessibility audit results parsed from SHAFT/Allure artifacts
model AccessibilityResult {
  id              String   @id @default(uuid())
  testExecutionId String   @unique
  scriptId        String?
  wcagLevel       String // "A" | "AA" | "AAA" | "None"
  passCount       Int      @default(0)
  violationCount  Int      @default(0)
  violations      Json // [{ ruleId, severity, element, description, fix }]
  createdAt       DateTime @default(now())

  @@index([scriptId])
}

// Section 1c: remote/Docker/Grid execution targets
model ExecutionTarget {
  id          String   @id @default(uuid())
  name        String
  type        String // "local" | "docker" | "grid" | "browserstack"
  url         String   @default("") // SHAFT executionAddress (e.g. localhost:4444)
  platform    String   @default("Linux") // "Linux" | "Windows" | "Mac"
  browser     String   @default("chrome")
  headless    Boolean  @default(false)
  credentials Json? // { username, accessKey } — for BrowserStack/grid auth
  isDefault   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Automation Hub AI Agent (Section 8)
model AgentChatMessage {
  id        String   @id @default(uuid())
  role      String // "user" | "assistant"
  content   String   @db.Text
  actions   Json? // embedded action buttons [{label, kind, payload}]
  createdAt DateTime @default(now())
}

model AgentToolCall {
  id        String   @id @default(uuid())
  tool      String
  params    Json?
  status    String // "success" | "error" | "denied"
  result    String   @db.Text
  duration  Int // milliseconds
  createdAt DateTime @default(now())
}

model AgentSettings {
  id         String   @id @default("agent-settings")
  provider   String   @default("Anthropic") // "Anthropic" | "OpenAI" | "Gemini" | "Ollama"
  apiKey     String   @default("")
  model      String   @default("claude-opus-4-8")
  permission String   @default("Execute Tests") // "Read-Only" | "Execute Tests" | "Full Control"
  updatedAt  DateTime @updatedAt
}

model HealingEvent {
  id               String   @id @default(uuid())
  originalLocator  String
  recoveredLocator String
  confidence       Float // e.g. 0.85
  pageUrl          String
  testName         String
  status           String // "recovered" | "failed" | "needs_review"
  createdAt        DateTime @default(now())
}

model FlakyTest {
  id             String   @id @default(uuid())
  testName       String
  flakinessScore Float
  totalRuns      Int
  failures       Int
  retries        Int
  rootCause      String
  suggestedFix   String
  trendDirection String // "up" | "down" | "flat"
  lastAnalyzed   DateTime @default(now())
}

model Diagnosis {
  id                   String    @id @default(uuid())
  testExecutionId      String
  testName             String
  errorMessage         String    @db.Text
  errorType            String    @default("Error")
  primaryCause         String
  confidence           Float
  findings             Json?
  remediationSteps     String    @db.Text
  status               String    @default("new") // "new" | "diagnosing" | "resolved"
  similarFailuresCount Int       @default(0)
  doctorReportPath     String
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?
}

model EvidenceFile {
  id              String   @id @default(uuid())
  testExecutionId String
  fileType        String // "screenshot" | "video" | "log" | "har"
  filePath        String
  stepNumber      Int
  pageUrl         String
  elementLocator  String
  status          String // "pass" | "fail" | "info"
  tags            String[]
  createdAt       DateTime @default(now())
}

model CrossBrowserResult {
  id             String   @id @default(uuid())
  testId         String
  browserName    String // "Chrome" | "Firefox" | "Edge" | "Safari"
  status         String // "pass" | "fail" | "flaky" | "not_run"
  duration       Int // duration in ms
  screenshotPath String?
  errorMessage   String?  @db.Text
  executionDate  DateTime @default(now())
}

model McpConfig {
  id              String   @id @default(uuid())
  serverUrl       String   @default("http://localhost:4000")
  provider        String   @default("Gemini")
  apiKey          String   @default("")
  model           String   @default("gpt-4o")
  permissionLevel String   @default("Can Execute Tests")
  updatedAt       DateTime @updatedAt
}

model McpActivity {
  id        String   @id @default(uuid())
  action    String
  status    String // "success" | "failed" | "pending"
  duration  Int // in ms
  result    String   @db.Text
  createdAt DateTime @default(now())
}

model RecorderSession {
  id        String   @id @default(uuid())
  url       String
  browser   String // "Chrome" | "Edge"
  device    String // "Desktop" | "Mobile"
  code      String   @db.Text
  status    String // "recording" | "completed"
  createdAt DateTime @default(now())
}

model AgentChatHistory {
  id        String   @id @default(uuid())
  role      String // "user" | "assistant"
  content   String   @db.Text
  mcpCalls  Json? // stores tool calls logs details
  createdAt DateTime @default(now())
}

// ===== Visual Diff (Section 9) — visual regression testing =====

model VisualBaseline {
  id          String             @id @default(uuid())
  testName    String
  pageName    String
  browser     String             @default("chrome")
  viewport    String             @default("") // e.g. "1920x1080"
  filePath    String // stored PNG path under public/uploads/visual/baselines
  versionTag  String             @default("")
  provider    String             @default("shaft-opencv") // "shaft-opencv" | "applitools" | "shutterbug"
  width       Int?
  height      Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  comparisons VisualComparison[]
}

model VisualComparison {
  id                String         @id @default(uuid())
  baselineId        String
  baseline          VisualBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  currentFilePath   String
  diffFilePath      String         @default("")
  diffScore         Float          @default(0) // percentage of changed pixels 0..100
  threshold         Float          @default(5) // percentage
  status            String         @default("pass") // "pass" | "fail" | "approved" | "rejected"
  provider          String         @default("shaft-opencv")
  dimensionMismatch Boolean        @default(false)
  createdAt         DateTime       @default(now())
}

// Section 12: Data & Config — centralized SHAFT configuration management.
// A SHAFT property whose value diverges from the built-in catalog default.
// The catalog itself lives in code (src/lib/hub-properties.ts); this table
// only persists overrides so we can attribute who changed what.
model ShaftProperty {
  id            String   @id @default(uuid())
  propertyName  String   @unique
  value         String   @db.Text
  description   String   @default("")
  propertyGroup String   @default("Other") // Browser | Execution | Synchronization | Evidence | Healing | AI | Other
  isCustom      Boolean  @default(true) // false = tracked but equals catalog default
  updatedBy     String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// Audit trail of every property value change (Properties Editor change history).
model PropertyHistory {
  id           String   @id @default(uuid())
  propertyName String
  oldValue     String   @default("") @db.Text
  newValue     String   @default("") @db.Text
  changedBy    String?
  changedAt    DateTime @default(now())

  @@index([propertyName])
  @@index([changedAt])
}

// Environment variables + Secrets manager. Non-secret values are stored in
// plaintext; secrets are AES-256-GCM encrypted (src/lib/crypto) and the
// ciphertext bundle is kept in valueEncrypted as JSON.
model EnvironmentVariable {
  id             String   @id @default(uuid())
  name           String
  valuePlain     String?  @db.Text // present when isSecret = false
  valueEncrypted Json? // { encrypted, iv, authTag, keyVersion } when isSecret = true
  scope          String   @default("global") // "global" | "project"
  isSecret       Boolean  @default(false)
  projectId      String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, scope, projectId])
  @@index([projectId])
}

// Section 11 (enhanced): AI Provider Management. One row per provider so each
// can be independently enabled, keyed, and pointed at a chosen model. The
// isDefault provider is what the agent uses (falls back to AgentSettings).
model AiProviderConfig {
  id        String   @id @default(uuid())
  provider  String   @unique // "OpenAI" | "Anthropic" | "Gemini" | "Ollama"
  enabled   Boolean  @default(false)
  apiKey    String   @default("")
  model     String   @default("")
  isDefault Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Real token usage recorded after each provider call (from the API's own usage
// fields). costUsd is derived from the per-model price table in code.
model AiUsageEvent {
  id               String   @id @default(uuid())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  command          String? // originating command/prompt label, if any
  createdAt        DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
}

// Consent, privacy and spend policy for AI usage (single row).
model AiPolicy {
  id               String   @id @default("ai-policy")
  allowDataAccess  Boolean  @default(true) // may test data be sent to the provider
  redactSensitive  Boolean  @default(true) // mask emails/keys/tokens before sending
  monthlyBudgetUsd Float    @default(0) // 0 = unlimited
  updatedAt        DateTime @updatedAt
}

// Phase 3 annotation editor: temporary shareable link for an annotated
// screenshot + its metadata. Public read by unguessable token; optional expiry.
model SharedAnnotation {
  id        String    @id @default(uuid())
  token     String    @unique
  imageUrl  String // public path, e.g. /uploads/shares/<token>.png
  title     String    @default("")
  metadata  Json? // { url, capturedAt, os, browser, dimensions, tags, description, severity }
  createdBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([token])
}

// Audit of what test data was sent to an AI provider and when.
model AiDataAccessLog {
  id          String   @id @default(uuid())
  provider    String
  dataSummary String // e.g. "list_tests → 5 scripts (1.2 KB)"
  redacted    Boolean  @default(false)
  withheld    Boolean  @default(false) // true when policy blocked the data entirely
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  SCRUM BOARD (spec-literal parallel system) — Task/BoardColumn/ProjectMember
//  Coexists with the existing Requirement/Sprint/Epic board. Names prefixed
//  where they would collide with existing models/enums.
// ═══════════════════════════════════════════════════════════════════════════

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  REVIEW
  TESTING
  DEPLOYED
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum ScrumSprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskType {
  STORY
  BUG
  TASK
  SUBTASK
  EPIC
}

enum TaskResolution {
  DONE
  WONT_FIX
  DUPLICATE
  CANNOT_REPRODUCE
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      String   @default("member") // admin, manager, member
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

model ScrumSprint {
  id        String            @id @default(cuid())
  name      String
  goal      String?
  status    ScrumSprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime          @default(now())

  @@index([projectId])
  @@index([status])
}

model ScrumEpic {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#3B82F6")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Task {
  id          String          @id @default(cuid())
  taskNumber  Int             @default(autoincrement())
  title       String
  description String?         @db.Text
  type        TaskType        @default(STORY)
  resolution  TaskResolution?
  status      TaskStatus      @default(TODO)
  priority    TaskPriority    @default(MEDIUM)
  storyPoints Float?
  dueDate     DateTime?
  branchName  String?
  progress    Int             @default(0) // 0-100
  boardRank   Int             @default(0) // ordering within a column
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      ScrumSprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId      String?
  epic        ScrumEpic?      @relation(fields: [epicId], references: [id], onDelete: SetNull)
  reporterId  String?
  reporter    User?           @relation("ScrumTaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignees   User[]          @relation("ScrumTaskAssignees")
  subtasks    Subtask[]
  comments    Comment[]
  activities  Activity[]
  testCaseLinks TaskTestCase[]
  bugLinks    TaskBug[]
  tags        String[]        @default([])

  // Jira-style detail fields
  originalEstimate  Int?     // minutes
  remainingEstimate Int?     // minutes
  timeSpent         Int?     // minutes
  environment       String?
  fixVersions       String[] @default([])
  affectedVersions  String[] @default([])
  components        String[] @default([])
  labels            String[] @default([])
  votes             Int      @default(0)
  votedBy           User[]   @relation("ScrumTaskVoters")
  watchers          User[]   @relation("ScrumTaskWatchers")
  linkedTasks       TaskLink[]       @relation("SourceTask")
  linkedToTasks     TaskLink[]       @relation("TargetTask")
  taskAttachments   TaskAttachment[]
  workLogs          WorkLog[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([sprintId])
  @@index([epicId])
  @@index([status])
}

model TaskLink {
  id        String   @id @default(cuid())
  type      String   // blocks, is blocked by, relates to, duplicates, clones
  sourceId  String
  targetId  String
  source    Task     @relation("SourceTask", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Task     @relation("TargetTask", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  name         String
  url          String
  size         Int      // bytes
  mimeType     String
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation("ScrumTaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model WorkLog {
  id          String   @id @default(cuid())
  timeSpent   Int      // minutes
  description String?  @db.Text
  startedAt   DateTime
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("ScrumWorkLogAuthor", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String // created, moved, assigned, updated, commented, ...
  details   String?  @db.Text
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model BoardColumn {
  id        String     @id @default(cuid())
  name      String
  status    TaskStatus
  order     Int
  wipLimit  Int?
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([projectId])
}

// Scrum traceability: link a Task (User Story) to existing TestCases and Bugs.
model TaskTestCase {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([taskId, testCaseId])
  @@index([taskId])
  @@index([testCaseId])
}

model TaskBug {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bugReportId String
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([taskId, bugReportId])
  @@index([taskId])
  @@index([bugReportId])
}

// Cross-feature assignee pool: users pulled from the connected management tool
// (Jira/Azure/OpenProject/ClickUp) plus manually-added people, each with an
// optional app-assigned free-text role. Used by Bug Reports, Test Cases, etc.
model ProjectTeamMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source     String   @default("synced") // "synced" | "manual"
  provider   String?  // integration provider when synced (OpenProject/Jira/AzureDevOps/ClickUp)
  externalId String?  // the tool's user id (null for manual)
  name       String
  email      String?
  role       String?  // app-assigned, optional, free text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, provider, externalId])
  @@index([projectId])
}
