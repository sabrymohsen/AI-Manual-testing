// ─── Unified project-management integration (Jira/Azure DevOps/ClickUp/OpenProject) ─
// Provider-agnostic replacement for the per-provider config. The connected tool is
// chosen per project; provider-specific settings live in JSON columns, while the
// connection/auth/toggles are typed. Reconciled against the WorkItemProvider
// abstraction in src/lib/integrations/core.

enum IntegrationProvider {
  OpenProject
  Jira
  AzureDevOps
  ClickUp
}

model ProjectIntegration {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider IntegrationProvider
  enabled  Boolean             @default(true)

  baseUrl            String
  // OP slug | Jira project key | ADO project | ClickUp list id
  externalProjectKey String
  username           String? // Jira account email / etc. (token-only providers leave null)

  // Encrypted API token / PAT / personal token (AES-256-GCM, src/lib/crypto)
  apiTokenEncrypted  String
  apiTokenIv         String
  apiTokenAuthTag    String
  apiTokenKeyVersion String @default("v1")

  // Provider-agnostic mapping config (see src/lib/integrations/core/types)
  typeMapping        Json? // { testCase, bug, userStory } -> external type id
  statusMapping      Json? // local status -> external status/state id
  boardConfig        Json? // { strategy, boardId, columnId, versionId, assigneeId }
  parentConfig       Json? // { strategy, defaultParentId }
  customFieldMapping Json?

  // Auto-sync toggles (parity with the legacy OpenProject flags)
  autoSyncTestCases      Boolean @default(false)
  autoSyncResults        Boolean @default(true)
  autoCreateBugOnFailure Boolean @default(true)
  autoSyncBugToTracker   Boolean @default(false)

  // Two-way (inbound) sync
  inboundSyncEnabled Boolean   @default(false)
  webhookSecret      String?
  externalWebhookId  String? // id of the webhook/service-hook we registered, for cleanup
  lastInboundAt      DateTime?

  // Monitoring
  lastConnectionStatus    String?
  lastConnectionCheckedAt DateTime?
  lastSyncAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

// ─── OpenProject Integration ─────────────────────────────────────────────────

enum OpenProjectParentStrategy {
  None
  SingleParent
  ByModule
  ByFeature
  ByRequirement
  ByTestSuite
}

enum OpenProjectBoardStrategy {
  StatusBased
  ParentChildBased
  TypeBased
  VersionBased
  CustomFieldBased
}

model OpenProjectIntegration {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  baseUrl                      String
  openProjectProjectIdentifier String

  // Encrypted API token (AES-256-GCM)
  apiTokenEncrypted  String
  apiTokenIv         String
  apiTokenAuthTag    String
  apiTokenKeyVersion String @default("v1")

  // Type mapping (IDs loaded dynamically from OpenProject)
  testCaseTypeId  String?
  bugTypeId       String?
  userStoryTypeId String?

  // Status mapping (local status → OpenProject status ID)
  defaultStatusId     String?
  notExecutedStatusId String?
  runningStatusId     String?
  passedStatusId      String?
  failedStatusId      String?
  blockedStatusId     String?

  // Parent strategy
  parentStrategy             OpenProjectParentStrategy @default(None)
  defaultParentWorkPackageId String?

  // Board strategy
  boardStrategy        OpenProjectBoardStrategy @default(StatusBased)
  targetBoardId        String?
  targetColumnStatusId String? // status ID of the board column to place WPs in
  targetVersionId      String?
  targetAssigneeId     String?
  customFieldMapping   Json?

  // Auto-sync toggles
  autoSyncTestCases        Boolean @default(false)
  autoSyncResults          Boolean @default(true)
  autoCreateBugOnFailure   Boolean @default(true)
  autoSyncBugToOpenProject Boolean @default(false)

  // Monitoring
  lastConnectionStatus    String?
  lastConnectionCheckedAt DateTime?
  lastSyncAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpenProjectParentMapping {
  id              String  @id @default(uuid())
  projectId       String
  mappingType     String // "Module" | "Feature" | "Requirement" | "TestSuite"
  localEntityId   String
  localEntityName String?

  openProjectParentId      String
  openProjectParentSubject String?
  openProjectParentUrl     String?

  validationStatus String? // "valid" | "invalid" | "unchecked"
  lastValidatedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, mappingType, localEntityId])
  @@index([projectId])
}

model OpenProjectSyncRun {
  id        String @id @default(uuid())
  projectId String
  operation String // "bulk-sync-test-cases" | "apply-parent" | "sync-to-board" | "check-board" | etc.
  status    String // "Queued" | "Running" | "Completed" | "Failed"

  totalCount   Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)
  skippedCount Int @default(0)
  failedCount  Int @default(0)

  details Json? // Array of per-item results
  error   String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ─── Per-feature OpenProject config ──────────────────────────────────────────
// Each feature can override (or inherit) the project-level OpenProjectIntegration.
// null fields mean "inherit from project config".
// featureId is a Feature.id UUID or the literal string "unassigned".

model OpenProjectFeatureConfig {
  id        String @id @default(uuid())
  projectId String
  featureId String // Feature.id | "unassigned"

  // Connection overrides (null = inherit from OpenProjectIntegration)
  baseUrl                      String?
  openProjectProjectIdentifier String?

  // Encrypted API token override (null = inherit from project token)
  apiTokenEncrypted  String?
  apiTokenIv         String?
  apiTokenAuthTag    String?
  apiTokenKeyVersion String  @default("v1")

  // Type mapping override
  testCaseTypeId String?

  // Status mapping overrides (null = inherit from project config)
  passedStatusId  String?
  failedStatusId  String?
  blockedStatusId String?
  defaultStatusId String?

  // Board & version targeting (null = inherit from project config)
  targetBoardId        String?
  targetBoardType      String? // "status" | "version" | "assignee" | "basic"
  targetColumnStatusId String? // status ID of the board column to place WPs in
  targetVersionId      String?

  // Last sync outcome for this feature
  lastSyncAt     DateTime?
  lastSyncStatus String? // "success" | "failed"
  lastSyncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, featureId])
  @@index([projectId])
}

model TestScript {
  id                   String          @id @default(uuid())
  name                 String
  type                 String // "Web" | "API" | "Database"
  code                 String          @db.Text
  tags                 String[]
  accessibilityEnabled Boolean         @default(false) // run WCAG audit on execution (Section 1b)
  // Owning project; null = a shared example every project sees.
  projectId            String?
  // Folder / suite in the hub's test list ("" = top level). Run a whole folder at once.
  folder               String          @default("")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  executions           TestExecution[]
  testCaseLinks        HubScriptTestCase[]

  @@index([projectId])
}

// Which manual test cases an automated script verifies. When the script runs,
// those cases' last status (and so test-library and BRD coverage) follow it.
model HubScriptTestCase {
  scriptId   String
  script     TestScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  linkedAt   DateTime   @default(now())

  @@id([scriptId, testCaseId])
  @@index([testCaseId])
}

// A recurring run: "every weekday at 02:00, run the regression folder".
model HubSchedule {
  id            String    @id @default(cuid())
  projectId     String
  name          String
  // { scriptIds?: string[], folder?: string, tag?: string } — empty = all tests
  scope         Json
  browser       String    @default("Headless")
  // daily | weekdays | hourly
  frequency     String
  // "HH:MM" in the server's local time for daily/weekdays
  timeOfDay     String?
  everyHours    Int?
  enabled       Boolean   @default(true)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  lastBatchId   String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([enabled, nextRunAt])
}

// Token a CI pipeline uses to start runs. Only a SHA-256 hash is stored; the
// token is shown once at creation.
model HubTriggerToken {
  id            String    @id @default(cuid())
  projectId     String
  name          String
  tokenHash     String    @unique
  prefix        String
  createdById   String?
  createdByName String?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([projectId])
}

model TestExecution {
  id              String     @id @default(uuid())
  scriptId        String
  script          TestScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  status          String // "Passed" | "Failed" | "Running"
  logOutput       String     @db.Text
  allureLink      String?
  browser         String? // "Chrome" | "Firefox" | "Edge" | "Headless"
  duration        Int? // execution duration in milliseconds
  screenshotPath  String? // absolute path of the captured screenshot evidence
  executionTarget String? // name of the execution target it ran on (Section 1c), null = Local
  // Per-test outcome parsed from Playwright's JSON report: [{ title, status, durationMs, error, screenshot, trace, video }]
  results         Json?
  // Shared by every execution started together (Run folder / Run all), null for a single run.
  batchId         String?
  // Project the run belongs to. Shared example scripts have no project of
  // their own, so the run records which project started it.
  projectId       String?
  // manual | rerun | schedule | ci
  triggerSource   String?
  triggeredById   String?
  triggeredByName String?
  createdAt       DateTime   @default(now())

  @@index([batchId])
  @@index([projectId, createdAt])
}

// Section 1a: external SHAFT test data files (data-driven testing)
model TestDataFile {
  id              String   @id @default(uuid())
  name            String // display name, e.g. "loginUsers"
  fileName        String   @unique // on-disk name, e.g. "loginUsers.json"
  filePath        String // absolute path under src/test/resources/testDataFiles/
  content         String   @db.Text // JSON content — DB is source of truth, mirrored to disk
  jsonSchema      Json? // optional field definitions produced by the Create Data Set wizard
  linkedScriptIds String[] // TestScript ids this data file feeds (1:N)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Section 1b: WCAG accessibility audit results parsed from SHAFT/Allure artifacts
model AccessibilityResult {
  id              String   @id @default(uuid())
  testExecutionId String   @unique
  scriptId        String?
  wcagLevel       String // "A" | "AA" | "AAA" | "None"
  passCount       Int      @default(0)
  violationCount  Int      @default(0)
  violations      Json // [{ ruleId, severity, element, description, fix }]
  createdAt       DateTime @default(now())

  @@index([scriptId])
}

// Section 1c: remote/Docker/Grid execution targets
model ExecutionTarget {
  id          String   @id @default(uuid())
  name        String
  type        String // "local" | "docker" | "grid" | "browserstack"
  url         String   @default("") // SHAFT executionAddress (e.g. localhost:4444)
  platform    String   @default("Linux") // "Linux" | "Windows" | "Mac"
  browser     String   @default("chrome")
  headless    Boolean  @default(false)
  credentials Json? // { username, accessKey } — for BrowserStack/grid auth
  isDefault   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Automation Hub AI Agent (Section 8)
model AgentChatMessage {
  id        String   @id @default(uuid())
  role      String // "user" | "assistant"
  content   String   @db.Text
  actions   Json? // embedded action buttons [{label, kind, payload}]
