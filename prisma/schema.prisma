  description  String?
  priority     Priority      @default(Medium)
  status       EpicStatus    @default(Active)
  orderIndex   Int           @default(0)
  requirements Requirement[]
  features     Feature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([projectId, epicKey])
  @@index([projectId])
}

model Requirement {
  id                 String                 @id @default(uuid())
  projectId          String
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting an Epic never deletes stories at the DB level — SetNull orphans
  // them; cascade delete of children is an explicit app-side choice.
  epicId             String?
  epic               Epic?                  @relation(fields: [epicId], references: [id], onDelete: SetNull)
  requirementKey     String
  title              String
  description        String?
  acceptanceCriteria String?
  priority           Priority               @default(Medium)
  status             RequirementStatus      @default(Draft)
  source             RequirementSource      @default(Manual)
  // Ordering position in the product backlog view (lower = higher priority).
  backlogRank        Int?
  // Scrum board fields (Story = Requirement)
  storyPoints        Int?
  assignee           String? // free-text name/email for Phase 1
  labels             String[]
  sprintId           String?
  sprint             Sprint?                @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  // Rank within a sprint / backlog column (lower = higher). Distinct from backlogRank.
  boardRank          Int?
  // Optional middle layer: assigning a feature auto-aligns epicId app-side
  featureId          String?
  feature            Feature?               @relation(fields: [featureId], references: [id], onDelete: SetNull)
  // Hierarchy: a Task/Bug hangs off a parent Story (Epic → Story → Task/Bug).
  parentId           String?
  parent             Requirement?           @relation("RequirementChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Requirement[]          @relation("RequirementChildren")
  figmaUrl           String?
  externalUrl        String?
  externalSystem     String? // Jira, Azure DevOps, GitHub, Manual, Other
  testCases          TestCaseRequirement[]
  bugReports         BugReportRequirement[]
  subtasks           RequirementSubtask[]
  dueDate            DateTime?
  timeEstimate       Int?
  timeSpent          Int?
  comments           RequirementComment[]
  sourceImportId     String?
  sourceImport       RequirementImport?     @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  sourceLocation     Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([projectId, requirementKey])
  @@index([projectId])
  @@index([epicId])
  @@index([status])
  @@index([featureId])
  @@index([sprintId])
  @@index([parentId])
}

model RequirementComment {
