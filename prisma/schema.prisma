datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; the openssl-3.0.x targets cover the deployed
  // containers (Alpine app image / Debian worker + recorder images). Pinned
  // explicitly because Prisma's openssl auto-detection fails on Alpine and
  // would otherwise generate the wrong (linux-musl / openssl-1.1) engine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Environment {
  Dev
  Staging
  UAT
  Production
}

enum BrowserType {
  Chromium
  Firefox
  WebKit
}

enum ViewportType {
  Desktop
  Tablet
  Mobile
  Custom
}

enum TestType {
  Functional
  VisualDesign
  E2E
  Regression
  Smoke
  Exploratory
}

enum Priority {
  Low
  Medium
  High
  Critical
}

enum RequirementStatus {
  Draft
  ReadyForTesting
  InTesting
  Covered
  PartiallyCovered
  Failed
  Blocked
  Deprecated
}

enum RequirementSource {
  Manual
  ExcelImport
  Jira
  AzureDevOps
  GitHub
  Figma
  AIGenerated
  OpenProject
}

enum TestRunStatus {
  Queued
  Running
  Passed
  Failed
  Blocked
  Warning
  Cancelled
}

enum StepStatus {
  Pending
  Running
  Passed
  Failed
  Blocked
  Warning
  Skipped
  SelfHealed
}

enum ExecutionMode {
  Normal
  SelfHealing
  Debug
}

enum ExecutionType {
  Manual
  Automated
}

/// Denormalised latest execution outcome for a TestCase.
///
/// Unifies TestRunStatus (automated) and StepStatus (manual) into the subset
/// that is meaningful as a *case-level* verdict. Queued/Running/Pending are
/// deliberately absent: an in-flight run never overwrites the last settled
/// result, so the list never flickers to "unknown" mid-run.
enum TestCaseStatus {
  NotExecuted
  Passed
  Failed
  Blocked
  Warning
  Skipped
}

// Authoring lifecycle of a test case, independent of its last run verdict.
// Draft cases are still being written; Deprecated cases are retired and are
// skipped when a test plan is run.
enum TestCaseReviewState {
  Draft
  Ready
  Approved
  Deprecated
}

enum TestCaseSource {
  Manual
  AIGenerated
  Imported
  Exploratory
  Recorder
  QAAgentBrain
  RequirementFile
}

enum ActionType {
  open_url
  click
  fill
  select
  select_custom
  select_searchable
  multi_select
  remove_multi_select_value
  autocomplete_select
  date_select
  time_select
  upload_file
  check
  uncheck
  radio_select
  tab_select
  menu_select
  modal_open
  modal_close
  table_row_select
  pagination_next
  pagination_previous
  accordion_expand
  accordion_collapse
  toggle_on
  toggle_off
  slider_set
  wait_for_text
  wait_for_url
  assert_visible
  assert_hidden
  assert_text
  assert_url
  assert_api_status
  screenshot
  custom_instruction
  visible
  hidden
  text_contains
  text_equals
  value_equals
  url_equals
  url_contains
  title_contains
  wait
  note
}

enum TargetType {
  test_id
  role
  text
  label
  placeholder
  css
  xpath
  url
  none
}

enum LogLevel {
  info
  warning
  error
  debug
}

enum LogSource {
  browser
  server
  playwright
  ai
  network
}

enum JobStatus {
  Queued
  Running
  Completed
  Failed
  Cancelled
}

enum UserPlan {
  Free
  Pro
}

enum UserRole {
  User
  Manager
  Admin
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String?
  plan           UserPlan  @default(Free)
  role           UserRole  @default(User)
  isActive       Boolean   @default(true)
  // Free-trial lifecycle. On signup a user gets a Pro trial: plan=Pro with
  // trialEndsAt in the future. When trialEndsAt elapses they are downgraded to
  // Free (trialEndsAt is kept, in the past, so it reads as an "expired trial").
  // A paid Pro user has trialEndsAt = null (never auto-downgrades).
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projects     Project[]
  auditLogs    AuditLog[]
  reportedBugs BugReport[]   @relation("BugReporter")
  transactions Transaction[]

  // ── Scrum board (spec-literal parallel system) ──
  avatarUrl            String?
  scrumTasks           Task[]           @relation("ScrumTaskAssignees")
  reportedScrumTasks   Task[]           @relation("ScrumTaskReporter")
  assignedSubtasks     Subtask[]        @relation("ScrumSubtaskAssignee")
  votedScrumTasks      Task[]           @relation("ScrumTaskVoters")
  watchedScrumTasks    Task[]           @relation("ScrumTaskWatchers")
  scrumTaskAttachments TaskAttachment[] @relation("ScrumTaskAttachmentUploader")
  scrumWorkLogs        WorkLog[]        @relation("ScrumWorkLogAuthor")
  scrumComments        Comment[]
  scrumActivities      Activity[]
  projectMemberships   ProjectMember[]

  // ── Chat relations ──
  channelsCreated    ChatChannel[]    @relation("ChannelCreator")
  channelMemberships ChannelMember[]
  chatMessages       ChatMessage[]    @relation("MessageSender")
  chatReactions      Reaction[]
  chatMentions       MessageMention[]
  presence           Presence?

  // ── RBAC ──
  sentInvitations Invitation[] @relation("SentInvitations")

  // ── Profile ──
  bio        String? @db.Text
  jobTitle   String?
  department String?
  phone      String?
  timezone   String  @default("UTC")
  language   String  @default("en")
  theme      String  @default("system") // light | dark | system

  notifications  Notification[]
  userActivities UserActivity[]
  scrumSavedViews ScrumSavedView[] @relation("ScrumSavedViewOwner")
}

// In-app notification center. Each notification belongs to exactly one user
// and optionally one project.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // MENTION | INVITATION | TASK_ASSIGNED | SPRINT_STARTED | COMMENT | CHAT_MESSAGE | SYSTEM
  title     String
  body      String    @db.Text
  data      Json?
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actionUrl String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Cross-project personal activity feed shown on the profile page.
model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // TASK_CREATED | TASK_COMPLETED | SPRINT_STARTED | SPRINT_COMPLETED | PROJECT_JOINED | PROFILE_UPDATED | FILE_UPLOADED | WORK_LOGGED | PASSWORD_CHANGED
  description String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Generic platform key/value settings (e.g. default trial length). Admin-editable.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id            String   @id @default(uuid())
  name          String
  price         Float
  billingPeriod String // "monthly" | "yearly"
  features      String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  status    String // "Success" | "Failed"
  plan      UserPlan
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  webAppUrl   String
  figmaUrl    String?
  description String?
  environment Environment   @default(Staging)
  browserType BrowserType   @default(Chromium)
  viewport    ViewportType  @default(Desktop)
  testType    TestType      @default(Functional)
  status      ProjectStatus @default(Active)

  customViewportWidth  Int?
  customViewportHeight Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentials        ProjectCredential[]
  figmaConfig        FigmaConfig?
  integrationConfig  IntegrationConfig?
  testCases          TestCase[]
  testSuites         TestSuite[]
  testPlans          TestPlan[]
  testRuns           TestRun[]
  auditLogs          AuditLog[]
  elementLocators    ElementLocator[]
  elementCollections ElementCollection[]
  recordingSessions  RecordingSession[]
  features           Feature[]

  manualTestSessions      ManualTestSession[]
  reusableStepFlows       ReusableStepFlow[]
  testDataVariables       TestDataVariable[]
  requirements            Requirement[]
  epics                   Epic[]
  requirementImports      RequirementImport[]
  bugReports              BugReport[]
  figmaFrames             FigmaFrame[]
  visualCheckMappings     VisualCheckMapping[]
  visualToleranceProfiles VisualToleranceProfile[]
  visualCheckRuns         VisualCheckRun[]
  autonomousAgentRuns     AutonomousAgentRun[]
  agentBrainRuns          AgentBrainRun[]
  agentMemories           AgentMemory[]
  qaAgentRuns             QAAgentRun[]
  openProjectIntegration  OpenProjectIntegration?
  projectIntegration      ProjectIntegration?
  aiConfig                ProjectAiConfig?
  sprints                 Sprint[]
  teamVelocities          TeamVelocity[]

  // ── Scrum board (spec-literal parallel system) ──
  boardKey       String?
  scrumSprints   ScrumSprint[]
  scrumEpics     ScrumEpic[]
  scrumTasks     Task[]
  boardColumns   BoardColumn[]
  projectMembers ProjectMember[]
  teamMembers    ProjectTeamMember[]
  invitations    Invitation[]

  // ── Chat relations ──
  chatChannels ChatChannel[]

  // ── Notifications & profile activity ──
  notifications  Notification[]
  userActivities UserActivity[]

  // ── BA BRD document hub ──
  brdDocuments BrdDocument[]

  // ── Generic cross-entity links ──
  entityLinks EntityLink[]

  // ── Visual tests (whole-site, URL list, flow checkpoints) ──
  visualTests    VisualTest[]
  visualTestRuns VisualTestRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scrumSavedViews ScrumSavedView[]
  @@index([userId])
  @@index([status])
  @@index([environment])
  @@index([createdAt])
}

model ProjectCredential {
  id                String  @id @default(uuid())
  roleName          String
  username          String
  encryptedPassword String
  encryptionIv      String
  encryptionAuthTag String
  keyVersion        String  @default("v1")
  loginUrl          String?
  notes             String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  auditLogs          AuditLog[]
  testRuns           TestRun[]
  testCases          TestCase[]
  recordingSessions  RecordingSession[]
  manualTestSessions ManualTestSession[]
  visualTests        VisualTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([roleName])
}

model FigmaConfig {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  encryptedApiToken String?
  encryptionIv      String?
  encryptionAuthTag String?
  keyVersion        String  @default("v1")

  fileKey                String?
  nodeId                 String?
  visualTolerancePercent Float     @default(1.0)
  lastFetchedAt          DateTime?
}

model TestCase {
  id            String         @id @default(uuid())
  title         String
  priority      Priority       @default(Medium)
  preconditions String?
  source        TestCaseSource @default(Manual)
  executionType ExecutionType  @default(Manual)

  requiredCredentialId String?
  requiredCredential   ProjectCredential? @relation(fields: [requiredCredentialId], references: [id], onDelete: SetNull)

  testData Json?
  tags     String[]
  assignee String? // team-member id/name from the project's assignee pool (ProjectTeamMember)

  // Authoring state. Existing and imported cases default to Ready so nothing
  // already in use drops out of runs; the editor starts new cases as Draft.
  reviewState      TestCaseReviewState @default(Ready)
  // Tester's estimate of how long one manual execution takes, for planning.
  estimatedMinutes Int?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // ── Filing ────────────────────────────────────────────────────────────────
  // Where the case LIVES. Exactly one suite (or none = "Unfiled"), so suite
  // counts sum to the project total. This is deliberately separate from
  // `requirements` below, which is many-to-many and answers a different
  // question — what the case COVERS. Conflating the two is what made the old
  // tree double-count cases linked to stories under two different epics.
  suiteId String?
  suite   TestSuite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)

  // ── Execution rollup ──────────────────────────────────────────────────────
  // Denormalised so the list can filter, sort and paginate in the database.
  // Previously "last status" existed nowhere in Postgres and was recomputed in
  // the browser by scanning every TestRun and ManualSessionCase in the project,
  // which is what forced the page to download the entire history to render 30
  // rows. Maintained at the write points in src/lib/test-cases/rollup.ts.
  lastStatus    TestCaseStatus @default(NotExecuted)
  lastRunAt     DateTime?
  lastRunId     String?
  lastRunSource ExecutionType?
  openBugCount  Int            @default(0)

  steps              TestStep[]
  testRuns           TestRun[]
  manualSessionCases ManualSessionCase[]
  requirements       TestCaseRequirement[]
  bugReports         BugReport[]
  visualTest         VisualTest?
  scrumTaskLinks     TaskTestCase[]
  versions           TestCaseVersion[]
  planLinks          TestPlanCase[]
  brdRequirementLinks BrdRequirementTestCase[]
  hubScriptLinks      HubScriptTestCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([priority])
  @@index([source])
  @@index([executionType])
  @@index([suiteId])
  // Composite indexes for the two list queries that matter: filter-by-status
  // within a project, and browse-a-suite.
  @@index([projectId, lastStatus])
  @@index([projectId, suiteId])
  @@index([projectId, assignee])
}

// A snapshot of a test case taken just before each edit, so any earlier
// version can be inspected or restored. `snapshot` holds the editable fields
// and the steps exactly as they were.
model TestCaseVersion {
  id         String   @id @default(uuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  version  Int
  snapshot Json
  // What the edit that REPLACED this version changed, e.g. "steps, priority".
  summary  String?

  changedById   String?
  changedByName String?
  createdAt     DateTime @default(now())

  @@unique([testCaseId, version])
  @@index([testCaseId])
}

// A saved, re-runnable set of test cases, e.g. "Sprint 14 regression".
model TestPlan {
  id          String  @id @default(uuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?

  createdById   String?
  createdByName String?

  cases TestPlanCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model TestPlanCase {
  planId     String
  plan       TestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  addedAt    DateTime @default(now())

  @@id([planId, testCaseId])
  @@index([testCaseId])
}

/// A folder in the test library. Project-scoped, self-referencing tree.
///
/// This is the ownership hierarchy the page was missing: previously the left
/// tree was projected from Requirement, so there was nowhere to actually put a
/// case, and cases with no story link were unreachable in the tree entirely.
model TestSuite {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Deleting a parent removes its subtree; TestCase.suiteId is SetNull, so
  // cases survive a suite deletion and fall back to "Unfiled".
  parentId String?
  parent   TestSuite?  @relation("SuiteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TestSuite[] @relation("SuiteTree")

  name        String
  description String?
  orderIndex  Int     @default(0)

  // ── Link to an Epic/Feature in the project's tracker ────────────────────────
  // A module may be imported from the management tool instead of typed by hand.
  // Only container types (Epic, Feature) are ever linked: a module is a part of
  // the system under test, not a unit of work, so Stories and Tasks are the
  // wrong grain and are never offered.
  //
  // Nullable throughout, because a locally-created module is still a first-class
  // module — the tracker is an optional source, not the source of truth. When
  // the link is set, the name and parent follow the tracker on refresh; nothing
  // else about the module does.
  externalProvider ExternalProvider?
  externalId       String?
  // The tracker's own type name, e.g. "Epic" / "Feature" — shown on the row.
  externalType     String?
  externalUrl      String?
  externalSyncedAt DateTime?

  testCases  TestCase[]
  bugReports BugReport[]
  visualTests VisualTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, parentId, orderIndex])
  // Import and refresh both ask "is this Epic already a module here?".
  @@index([projectId, externalProvider, externalId])
}

model TestStep {
  id         String   @id @default(uuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  stepNumber        Int
  actionDescription String
  expectedResult    String

  actionType  ActionType @default(custom_instruction)
  targetType  TargetType @default(none)
  targetValue String?
  inputValue  String?
  timeoutMs   Int        @default(10000)
  assertions  Json?

  componentType       String?
  groupId             String?
  rawEvents           Json?
  actionMetadata      Json?
  locatorCandidates   Json?
  selectedOptionText  String?
  selectedOptionValue String?
  validationStatus    String?
  validationMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stepResults       TestStepResult[]
  manualStepResults ManualStepResult[]

  @@index([testCaseId])
  @@index([stepNumber])
}

model TestRun {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId String?
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  status        TestRunStatus @default(Queued)
  roleUsed      String        @default("None")
  executionMode ExecutionMode @default(SelfHealing)

  browserType    BrowserType
  viewport       ViewportType
  viewportWidth  Int?
  viewportHeight Int?

  triggeredBy TestCaseSource @default(Manual)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int       @default(0)

  autonomousAgentRunId String?
  autonomousAgentRun   AutonomousAgentRun? @relation(fields: [autonomousAgentRunId], references: [id], onDelete: SetNull)
  agentBrainRunId      String?
  agentBrainRun        AgentBrainRun?      @relation(fields: [agentBrainRunId], references: [id], onDelete: SetNull)

  jobs          TestJob?
  logs          Log[]
  networkLogs   NetworkLog[]
  stepResults   TestStepResult[]
  bugReports    BugReport[]
  attachments   Attachment[]
  visualResults VisualComparisonResult[]
  visualTestRuns VisualTestRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([testCaseId])
  @@index([status])
  @@index([autonomousAgentRunId])
  @@index([agentBrainRunId])
  @@index([createdAt])
}

model TestJob {
  id        String  @id @default(uuid())
  testRunId String  @unique
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  status   JobStatus @default(Queued)
  attempts Int       @default(0)
  error    String?
  workerId String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
}

model TestStepResult {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepId String?
  testStep   TestStep? @relation(fields: [testStepId], references: [id], onDelete: SetNull)

  stepNumber        Int
  actionDescription String
  expectedResult    String
  actualResult      String?

  status StepStatus @default(Pending)

  screenshotBefore String?
  screenshotAfter  String?
  errorDetails     String?
  notes            String?
  durationMs       Int     @default(0)
  actionMetadata   Json?

  logs          Log[]
  networkLogs   NetworkLog[]
  visualResults VisualComparisonResult[]
  bugReports    BugReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testRunId])
  @@index([testStepId])
  @@index([status])
}

model Log {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: Cascade)

  source  LogSource
  level   LogLevel
  message String
  raw     Json?

  timestamp DateTime @default(now())

  @@index([testRunId])
  @@index([testStepResultId])
  @@index([timestamp])
}

model NetworkLog {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: Cascade)

  url          String
  method       String
  status       Int?
  error        String?
  resourceType String?
  durationMs   Int     @default(0)

  requestHeaders      Json?
  responseHeaders     Json?
  responseBodyPreview String?

  timestamp DateTime @default(now())

  @@index([testRunId])
  @@index([testStepResultId])
  @@index([timestamp])
}

model VisualComparisonResult {
  id String @id @default(uuid())

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  stepResultId String?
  stepResult   TestStepResult? @relation(fields: [stepResultId], references: [id], onDelete: SetNull)

  figmaImagePath  String
  actualImagePath String
  diffImagePath   String?

  mismatchPercent  Float
  tolerancePercent Float
  viewportWidth    Int
  viewportHeight   Int
  status           StepStatus

  createdAt DateTime @default(now())

  @@index([testRunId])
  @@index([stepResultId])
}

model BugReport {
  id     String  @id @default(uuid())
  bugKey String? // e.g. BUG-0001
  title  String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId String?
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  testRunId String?
  testRun   TestRun? @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  autonomousAgentRunId String?
  autonomousAgentRun   AutonomousAgentRun? @relation(fields: [autonomousAgentRunId], references: [id], onDelete: SetNull)
  agentBrainRunId      String?
  agentBrainRun        AgentBrainRun?      @relation(fields: [agentBrainRunId], references: [id], onDelete: SetNull)

  testStepResultId String?
  testStepResult   TestStepResult? @relation(fields: [testStepResultId], references: [id], onDelete: SetNull)

  // Which module/service of the system the defect belongs to. Deliberately its
  // OWN field rather than something derived from testCase.suite: most bugs are
  // filed by hand during exploratory testing and never point at a case, and a
  // defect can belong to a module none of its cases live in. Auto-filled from
  // the linked case's suite when one exists, then freely editable.
  // SetNull, so deleting a suite leaves its bugs unfiled rather than deleting
  // them.
  suiteId String?
  suite   TestSuite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)

  severity Priority
  priority Priority
  status   BugStatus @default(Open)

  // How the bug was resolved (set when moving to Resolved/Closed/Rejected).
  resolution     BugResolution?
  resolutionNote String?

  // How many times this bug has been reopened after being resolved or closed.
  // `Reopened` already existed as a *status*, but a status only says where the
  // bug is now — it can't distinguish a defect reopened once from one that has
  // failed verification three times, which is a materially different problem.
  // Incremented by the workflow in src/lib/bug-reports/workflow.ts.
  reopenCount Int @default(0)

  // Free-form triage labels e.g. ["regression", "ui", "security"].
  tags String[] @default([])

  // App-side "Bug Source" (e.g. where the defect was found). Free string whose
  // dropdown options can be pulled from an OpenProject list field; stored here
  // on the bug and NOT synced to OpenProject as a custom field.
  source String?

  environment Environment?
  roleUsed    String?
  browser     BrowserType?
  viewport    ViewportType?

  assignedTo String?

  // Who filed the bug (auto-set to the creating user).
  reporterId String?
  reporter   User?   @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // OpenProject parent work package to nest this bug under when synced.
  openProjectParentId      String?
  // OpenProject board (grid id) the synced bug should be placed on.
  openProjectBoardId       String?
  // OpenProject board column (widget id) the synced bug should be placed under.
  openProjectBoardColumnId String?
  // Values for OpenProject required/custom fields on the bug type, keyed by
  // schema field key (e.g. { "customField6": { type, value } }).
  openProjectCustomFields  Json?

  stepsToReproduce String
  expectedResult   String
  actualResult     String

  screenshotPath String?
  consoleLogs    String?
  networkErrors  String?

  // Auto-captured live-session context (Testing Workstation)
  pageUrl          String?
  osInfo           String?
  screenResolution String?
  videoUrl         String?

  comments       BugComment[]
  activities     BugActivity[]
  bugAttachments BugAttachment[]

  attachments Attachment[]

  manualTestSessionId String?
  manualTestSession   ManualTestSession? @relation(fields: [manualTestSessionId], references: [id], onDelete: SetNull)

  // Live QA Session this bug was filed from (powers the Live QA History bug count).
  recordingSessionId String?
  recordingSession   RecordingSession? @relation(fields: [recordingSessionId], references: [id], onDelete: SetNull)

  requirements       BugReportRequirement[]
  scrumTaskLinks     TaskBug[]
  recordedTestCaseId String?
  recordedTestCase   RecordedTestCase?       @relation(fields: [recordedTestCaseId], references: [id], onDelete: SetNull)
  visualIssues       VisualDifferenceIssue[]
  occurrences        BugOccurrence[]
  visualScreens      VisualScreen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([testCaseId])
  @@index([suiteId])
  // The report and the module filter both ask "bugs of this project, by module".
  @@index([projectId, suiteId])
  @@index([testRunId])
  @@index([autonomousAgentRunId])
  @@index([agentBrainRunId])
  @@index([createdAt])
  // Finding repeat offenders is the point of tracking reopens.
  @@index([projectId, reopenCount])
}

