// ─── Epic — hierarchy layer above Requirement (user story) ──────────────────
// Orthogonal to the Module/Feature/Component tree by design.
enum EpicStatus {
  Draft
  Active
  Completed
  Archived
}

// Scrum board: a sprint groups Requirements(Stories) for a time-box.
enum SprintStatus {
  Future
  Active
  Completed
}

model Sprint {
  id           String         @id @default(uuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  goal         String?
  status       SprintStatus   @default(Future)
  startDate    DateTime?
  endDate      DateTime?
  orderIndex   Int            @default(0)
  completedAt  DateTime?
  requirements Requirement[]
