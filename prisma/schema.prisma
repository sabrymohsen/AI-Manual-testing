  safetyLevel           QAAgentSafetyLevel @default(ReadOnly)
  plan                  Json?
  scannerResult         Json?
  executionResult       Json?
  summary               Json?
  startedAt             DateTime?
  completedAt           DateTime?
  durationMs            Int                @default(0)
  progress              Int                @default(0)
  steps                 QAAgentRunStep[]
  findings              QAAgentFinding[]
  events                QAAgentRunEvent[]
  currentPhase          String?
  currentPhaseStartedAt DateTime?
  currentMessage        String?
  lastHeartbeatAt       DateTime?
