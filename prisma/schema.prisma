model AgentChatHistory {
  id        String   @id @default(uuid())
  role      String // "user" | "assistant"
  content   String   @db.Text
  mcpCalls  Json? // stores tool calls logs details
  createdAt DateTime @default(now())
}

// ===== Visual Diff (Section 9) — visual regression testing =====

model VisualBaseline {
  id          String             @id @default(uuid())
  testName    String
  pageName    String
  browser     String             @default("chrome")
  viewport    String             @default("") // e.g. "1920x1080"
  filePath    String // stored PNG path under public/uploads/visual/baselines
  versionTag  String             @default("")
  provider    String             @default("shaft-opencv") // "shaft-opencv" | "applitools" | "shutterbug"
  width       Int?
  height      Int?
  // Project the baseline belongs to; its comparisons inherit it. Baselines are
  // screenshots of the app under test, so they must not be workspace-wide.
  // Null = created before baselines had a project (admins only).
  projectId   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  comparisons VisualComparison[]

  @@index([projectId])
}

model VisualComparison {
  id                String         @id @default(uuid())
  baselineId        String
  baseline          VisualBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  currentFilePath   String
  diffFilePath      String         @default("")
  diffScore         Float          @default(0) // percentage of changed pixels 0..100
  threshold         Float          @default(5) // percentage
  status            String         @default("pass") // "pass" | "fail" | "approved" | "rejected"
  provider          String         @default("shaft-opencv")
  dimensionMismatch Boolean        @default(false)
  createdAt         DateTime       @default(now())
}

// Section 12: Data & Config — centralized SHAFT configuration management.
// A SHAFT property whose value diverges from the built-in catalog default.
// The catalog itself lives in code (src/lib/hub-properties.ts); this table
// only persists overrides so we can attribute who changed what.
model ShaftProperty {
  id            String   @id @default(uuid())
  propertyName  String   @unique
  value         String   @db.Text
  description   String   @default("")
  propertyGroup String   @default("Other") // Browser | Execution | Synchronization | Evidence | Healing | AI | Other
  isCustom      Boolean  @default(true) // false = tracked but equals catalog default
  updatedBy     String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// Audit trail of every property value change (Properties Editor change history).
model PropertyHistory {
  id           String   @id @default(uuid())
  propertyName String
  oldValue     String   @default("") @db.Text
  newValue     String   @default("") @db.Text
  changedBy    String?
  changedAt    DateTime @default(now())

  @@index([propertyName])
  @@index([changedAt])
}

// Environment variables + Secrets manager. Non-secret values are stored in
// plaintext; secrets are AES-256-GCM encrypted (src/lib/crypto) and the
// ciphertext bundle is kept in valueEncrypted as JSON.
model EnvironmentVariable {
  id             String   @id @default(uuid())
  name           String
  valuePlain     String?  @db.Text // present when isSecret = false
  valueEncrypted Json? // { encrypted, iv, authTag, keyVersion } when isSecret = true
  scope          String   @default("global") // "global" | "project"
  isSecret       Boolean  @default(false)
  projectId      String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, scope, projectId])
  @@index([projectId])
}

// Per-project AI provider. Set from the project's AI Provider tab so each team
// can bring its own key, model and spend, exactly like the tracker integration.
// Resolution order for any AI call is: this row -> the workspace-wide
// AiProviderConfig -> the provider's key env var.
//
// The key is AES-256-GCM encrypted (src/lib/crypto), matching how tracker tokens
// are stored — AiProviderConfig.apiKey is a plaintext column and is not a
// pattern worth repeating for a credential entered through the UI.
model ProjectAiConfig {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider String // "Kimi" | "OpenAI" | "Anthropic" | "Gemini" | "Ollama"
  enabled  Boolean @default(true)
  model    String  @default("")

  apiKeyEncrypted  String @default("")
  apiKeyIv         String @default("")
  apiKeyAuthTag    String @default("")
  apiKeyKeyVersion String @default("v1")

  /// Ollama only: where this project's Ollama server is (e.g. a tunnel to a
  /// tester's machine). Empty = the workspace URL, then OLLAMA_URL.
  baseUrl String @default("")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Section 11 (enhanced): AI Provider Management. One row per provider so each
// can be independently enabled, keyed, and pointed at a chosen model. The
// isDefault provider is what the agent uses (falls back to AgentSettings).
model AiProviderConfig {
  id        String   @id @default(uuid())
  provider  String   @unique // "OpenAI" | "Anthropic" | "Gemini" | "Ollama"
  enabled   Boolean  @default(false)
  apiKey    String   @default("")
  model     String   @default("")
  isDefault Boolean  @default(false)
  /// Ollama only: server URL for the workspace. Empty = OLLAMA_URL, then localhost.
  baseUrl   String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Real token usage recorded after each provider call (from the API's own usage
// fields). costUsd is derived from the per-model price table in code.
model AiUsageEvent {
  id               String   @id @default(uuid())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  command          String? // originating command/prompt label, if any
  createdAt        DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
}

// Consent, privacy and spend policy for AI usage (single row).
model AiPolicy {
  id               String   @id @default("ai-policy")
  allowDataAccess  Boolean  @default(true) // may test data be sent to the provider
  redactSensitive  Boolean  @default(true) // mask emails/keys/tokens before sending
  monthlyBudgetUsd Float    @default(0) // 0 = unlimited
  updatedAt        DateTime @updatedAt
}

// Phase 3 annotation editor: temporary shareable link for an annotated
// screenshot + its metadata. Public read by unguessable token; optional expiry.
model SharedAnnotation {
  id        String    @id @default(uuid())
  token     String    @unique
  imageUrl  String // public path, e.g. /uploads/shares/<token>.png
  title     String    @default("")
  metadata  Json? // { url, capturedAt, os, browser, dimensions, tags, description, severity }
  createdBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([token])
}

// Audit of what test data was sent to an AI provider and when.
model AiDataAccessLog {
  id          String   @id @default(uuid())
  provider    String
  dataSummary String // e.g. "list_tests → 5 scripts (1.2 KB)"
  redacted    Boolean  @default(false)
  withheld    Boolean  @default(false) // true when policy blocked the data entirely
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  SCRUM BOARD (spec-literal parallel system) — Task/BoardColumn/ProjectMember
//  Coexists with the existing Requirement/Sprint/Epic board. Names prefixed
//  where they would collide with existing models/enums.
// ═══════════════════════════════════════════════════════════════════════════

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  REVIEW
  TESTING
  DEPLOYED
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum ScrumSprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskType {
  STORY
  BUG
  TASK
  SUBTASK
  EPIC
  TEST_CASE
}

enum TaskResolution {
  DONE
  WONT_FIX
  DUPLICATE
  CANNOT_REPRODUCE
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      String   @default("Member") // RBAC project role: Owner, Admin, Member, Viewer (legacy rows may be lowercase)
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Per-member permission overrides. Null = inherit from role defaults.
  canCreateSprints  Boolean?
  canDeleteSprints  Boolean?
  canCreateEpics    Boolean?
  canDeleteEpics    Boolean?
  canCreateStories  Boolean?
  canDeleteStories  Boolean?
  canManageMembers  Boolean?
  canInviteMembers  Boolean?
  canDeleteProject  Boolean?
  canEditBoard      Boolean?
  canAccessReports  Boolean?
  canAccessSettings Boolean?
  canAccessChat     Boolean?
  canAccessMembers  Boolean?

  @@unique([userId, projectId])
  @@index([projectId])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id])
  role        String    @default("Member") // Owner, Admin, Member, Viewer
  status      String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([projectId])
  @@index([email])
}

model ScrumSprint {
  id        String            @id @default(cuid())
  name      String
  goal      String?
  status    ScrumSprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime          @default(now())

  @@index([projectId])
  @@index([status])
}

model ScrumEpic {
  id          String    @id @default(cuid())
  title       String
  description String?
  color       String    @default("#3B82F6")
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  brdLinks    BrdLink[]
  brdRequirements BrdRequirement[]
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

model Task {
  id            String          @id @default(cuid())
  // Per project (src/lib/scrum/task-number.ts); the sequence default only
  // serves rows created outside the app's own code paths.
  taskNumber    Int             @default(autoincrement())
  title         String
  description   String?         @db.Text
  type          TaskType        @default(STORY)
  resolution    TaskResolution?
  status        TaskStatus      @default(TODO)
  priority      TaskPriority    @default(MEDIUM)
  storyPoints   Float?
  // When work is planned to start (timeline bars run startDate → dueDate).
  startDate     DateTime?
  dueDate       DateTime?
  branchName    String?
  progress      Int             @default(0) // 0-100
  boardRank     Int             @default(0) // ordering within a column
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId      String?
  sprint        ScrumSprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId        String?
  epic          ScrumEpic?      @relation(fields: [epicId], references: [id], onDelete: SetNull)
  reporterId    String?
  reporter      User?           @relation("ScrumTaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignees     User[]          @relation("ScrumTaskAssignees")
  subtasks      Subtask[]
  comments      Comment[]
  activities    Activity[]
  testCaseLinks TaskTestCase[]
  bugLinks      TaskBug[]
  tags          String[]        @default([])

  // Jira-style detail fields
  originalEstimate  Int? // minutes
  remainingEstimate Int? // minutes
  timeSpent         Int? // minutes
  environment       String?
  fixVersions       String[]         @default([])
  affectedVersions  String[]         @default([])
  components        String[]         @default([])
  labels            String[]         @default([])
  votes             Int              @default(0)
  votedBy           User[]           @relation("ScrumTaskVoters")
  watchers          User[]           @relation("ScrumTaskWatchers")
  linkedTasks       TaskLink[]       @relation("SourceTask")
  linkedToTasks     TaskLink[]       @relation("TargetTask")
  taskAttachments   TaskAttachment[]
  workLogs          WorkLog[]
  brdLinks          BrdLink[]
  brdRequirements   BrdRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, taskNumber])
  @@index([projectId])
  @@index([sprintId])
  @@index([epicId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Analyst BRD document hub
// ─────────────────────────────────────────────────────────────────────────────

// Master BRD record. Always resolves to the latest version via currentVersionId.
// User references are denormalized (id + name snapshot) so audit/version trails
// stay intact even if a user is renamed or removed.
model BrdDocument {
  id               String          @id @default(cuid())
  name             String // display name
  filename         String // original uploaded filename
  fileType         String // "pdf" | "docx"
  status           String          @default("Draft") // Draft | Reviewed | Final | Archived
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId       String
  uploaderName     String
  currentVersionId String? // points at the latest BrdVersion.id
  versions         BrdVersion[]
  links            BrdLink[]
  annotations      BrdAnnotation[]
  auditLogs        BrdAuditLog[]
  requirements     BrdRequirement[]
  analyses         BrdAnalysis[]
  reviews          BrdReview[]
  isDeleted        Boolean         @default(false)
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([projectId, isDeleted])
}

model BrdVersion {
  id                String      @id @default(cuid())
  brdId             String
  brd               BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  versionNumber     Int
  storagePath       String // file on disk under STORAGE_ROOT
  fileType          String // "pdf" | "docx"
  fileSize          Int
  contentHtml       String?     @db.Text // editor-produced HTML (Word edits)
  // Plain text of this version — powers full-text search, version compare and
  // detecting which requirements changed. Filled at upload/save, backfilled lazily.
  textContent       String?     @db.Text
  changeSummary     String?
  editorId          String?
  editorName        String?
  previousVersionId String?
  createdAt         DateTime    @default(now())

  @@index([brdId])
}

// Bidirectional link from a BRD to an Epic or a User Story (Task). `label` is a
// snapshot so a link to a since-deleted item can still render as "Deleted item".
model BrdLink {
  id          String      @id @default(cuid())
  brdId       String
  brd         BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  linkType    String // "epic" | "story"
  epicId      String?
  epic        ScrumEpic?  @relation(fields: [epicId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  label       String
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([brdId])
  @@index([epicId])
  @@index([taskId])
}

model BrdAnnotation {
  id         String      @id @default(cuid())
  brdId      String
  brd        BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  page       Int? // PDF page (1-based)
  x          Float?
  y          Float?
  type       String // highlight | comment | rect | sticky | note
  color      String?
  text       String?     @db.Text
  quote      String?     @db.Text // the commented-on section text (soft anchor)
  parentId   String? // for threaded replies
  resolved   Boolean     @default(false)
  mentionIds String[]    @default([]) // team members @mentioned in this comment
  // Version the comment was written against, so it can be flagged as outdated
  // when its quoted text no longer appears in the current version.
  versionNumber Int?
  authorId   String?
  authorName String?
  createdAt  DateTime    @default(now())

  @@index([brdId])
  @@index([parentId])
}

// A requirement found in (or added to) a BRD. Test cases link to requirements
// so the hub can show coverage, and so a new BRD version can flag exactly the
// tests whose requirement changed.
/// One AI (or rule-based) analysis run of a BRD version. Suggestions are
/// reviewed before they become BrdRequirement rows.
model BrdAnalysis {
  id            String      @id @default(cuid())
  brdId         String
  brd           BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  versionNumber Int?
  /// queued | running | done | failed | applied
  status        String      @default("queued")
  /// "ai" | "rules"
  method        String      @default("ai")
  provider      String?
  model         String?
  /// Dominant language of the document: "ar" | "en" | "mixed"
  language      String?
  progress      Int         @default(0)
  totalChunks   Int         @default(0)
  summary       String?     @db.Text
  /// Suggested requirements (see src/lib/brd/analysis-types.ts)
  candidates    Json?
  /// Ambiguities, conflicts, gaps and open questions
  issues        Json?
  error         String?     @db.Text
  createdById   String?
  createdByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  finishedAt    DateTime?

  @@index([brdId, createdAt])
}

model BrdRequirement {
  id          String  @id @default(cuid())
  brdId       String
  brd         BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  key         String // e.g. REQ-3 or the document's own id (FR-12)
  title       String
  description String  @db.Text
  type        String?
  priority    String?
  orderIndex  Int     @default(0)
  // active | changed | removed — set when a new version no longer contains the text.
  status      String  @default("active")
  sourceVersionNumber Int?
  changedInVersion    Int?
  previousText        String? @db.Text

  /// How it got here: "manual" | "rules" | "ai". Null = before this was tracked
  /// (auto-found when sourceVersionNumber is set, hand-added otherwise).
  origin             String?
  /// Testable conditions (string[]), incl. field rules from the document's tables.
  acceptanceCriteria Json?
  /// Verbatim text from the document this requirement came from. Change
  /// detection checks this, since AI-written titles are paraphrases.
  sourceQuote        String? @db.Text
  /// Heading path, e.g. "1. الملحمة : … › 1.01 قصة المستخدم: …"
  section            String?
  /// Key of the parent epic, when the document groups stories under one.
  parentKey          String?
  /// "ar" | "en" | "mixed"
  language           String?
  confidence         Float?

  /// The Scrum story (or epic, for an epic requirement) made from this requirement.
  taskId String?
  task   Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  epicId String?
  epic   ScrumEpic?  @relation(fields: [epicId], references: [id], onDelete: SetNull)

  testCases BrdRequirementTestCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brdId])
  @@index([taskId])
  @@index([epicId])
}

model BrdRequirementTestCase {
  requirementId String
  requirement   BrdRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCaseId    String
  testCase      TestCase       @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  // Raised when the requirement changes in a new BRD version.
  needsReview   Boolean        @default(false)
  reviewReason  String?
  linkedAt      DateTime       @default(now())

  @@id([requirementId, testCaseId])
  @@index([testCaseId])
}

// A review request for one version of a BRD. When every reviewer of the
// current version approves, the BRD moves to Reviewed.
model BrdReview {
  id              String      @id @default(cuid())
  brdId           String
  brd             BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  versionId       String
  versionNumber   Int
  reviewerId      String
  reviewerName    String
  requestedById   String?
  requestedByName String?
  // Pending | Approved | ChangesRequested
  decision        String      @default("Pending")
  comment         String?     @db.Text
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())

  @@index([brdId])
  @@index([reviewerId])
}

// Immutable, non-deletable audit trail for a BRD.
model BrdAuditLog {
  id        String      @id @default(cuid())
  brdId     String
  brd       BrdDocument @relation(fields: [brdId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  actorId   String?
  actorName String?
  createdAt DateTime    @default(now())

  @@index([brdId])
}

model TaskLink {
  id        String   @id @default(cuid())
  type      String // blocks, is blocked by, relates to, duplicates, clones
  sourceId  String
  targetId  String
  source    Task     @relation("SourceTask", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Task     @relation("TargetTask", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  name         String
  url          String
  size         Int // bytes
  mimeType     String
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation("ScrumTaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model WorkLog {
  id          String   @id @default(cuid())
  timeSpent   Int // minutes
  description String?  @db.Text
  startedAt   DateTime
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("ScrumWorkLogAuthor", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId])
}

model Subtask {
  id          String   @id @default(cuid())
  title       String
  // Optional detail for the subtask — acceptance notes, repro steps, context.
  description String?  @db.Text
  completed   Boolean  @default(false)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Subtasks can be owned by a different person than the parent story, so work
  // inside one story can be split across the team.
  assigneeId  String?
  assignee    User?    @relation("ScrumSubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String // created, moved, assigned, updated, commented, ...
  details   String?  @db.Text
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model BoardColumn {
  id        String     @id @default(cuid())
  name      String
  status    TaskStatus
  order     Int
  wipLimit  Int?
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([projectId])
}

// Scrum traceability: link a Task (User Story) to existing TestCases and Bugs.
model TaskTestCase {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([taskId, testCaseId])
  @@index([taskId])
  @@index([testCaseId])
}

model TaskBug {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bugReportId String
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([taskId, bugReportId])
  @@index([taskId])
  @@index([bugReportId])
}

// Cross-feature assignee pool: users pulled from the connected management tool
// (Jira/Azure/OpenProject/ClickUp) plus manually-added people, each with an
// optional app-assigned free-text role. Used by Bug Reports, Test Cases, etc.
model ProjectTeamMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source     String   @default("synced") // "synced" | "manual"
  provider   String? // integration provider when synced (OpenProject/Jira/AzureDevOps/ClickUp)
  externalId String? // the tool's user id (null for manual)
  name       String
  email      String?
  role       String? // app-assigned, optional, free text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, provider, externalId])
  @@index([projectId])
}

model ChatChannel {
  id          String          @id @default(cuid())
  name        String
  slug        String // e.g., "general", "random", "bug-reports"
  description String?
  type        ChannelType     @default(PUBLIC)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User            @relation("ChannelCreator", fields: [createdById], references: [id])
  members     ChannelMember[]
  messages    ChatMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, slug])
}

enum ChannelType {
  PUBLIC // Anyone in project can join
  PRIVATE // Invite-only within project
  DIRECT // 1-on-1 DM
}

model ChannelMember {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  role       ChannelRole @default(MEMBER)
  lastReadAt DateTime    @default(now())
  muted      Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@unique([channelId, userId])
}

enum ChannelRole {
  OWNER
  ADMIN
  MEMBER
}

model ChatMessage {
  id             String           @id @default(cuid())
  content        String           @db.Text
  htmlContent    String?          @db.Text // sanitized HTML from TipTap
  // Entities referenced with `#` in the composer:
  // [{ type, id, key, label, url }]. Stored structured so the client can render
  // real chips and so notifications can name what was referenced.
  entityMentions Json?
  type           MessageType      @default(TEXT)
  channelId      String
  channel        ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation("MessageSender", fields: [senderId], references: [id])
  parentId       String? // for thread replies
  parent         ChatMessage?     @relation("ThreadReplies", fields: [parentId], references: [id])
  replies        ChatMessage[]    @relation("ThreadReplies")
  reactions      Reaction[]
  attachments    ChatAttachment[]
  mentions       MessageMention[]
  editedAt       DateTime?
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
}

enum MessageType {
  TEXT
  SYSTEM // "John joined the channel", "Sprint started"
  FILE
  CODE // Code block with syntax highlighting
}

model Reaction {
  id        String      @id @default(cuid())
  emoji     String // Unicode emoji or shortcode :thumbsup:
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
}

model MessageMention {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
}

model ChatAttachment {
  id        String      @id @default(cuid())
  name      String
  url       String
  size      Int // bytes
  mimeType  String
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

// Presence: who is online in which channel
model Presence {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  channelId String?
  isOnline  Boolean  @default(true)
  lastSeen  DateTime @default(now())
  typingIn  String? // channelId they're typing in
}

// ─────────────────────────────────────────────────────────────────────────────
// Generic cross-entity linking
// ─────────────────────────────────────────────────────────────────────────────

// Which kinds of thing can sit on either end of an EntityLink.
//
// SPRINT and EPIC refer to the Requirement-board `Sprint` / `Epic` models. The
// parallel Scrum board's ScrumSprint / ScrumEpic are reachable through their
// tasks and are deliberately not linkable directly, so a link target is never
// ambiguous between the two board systems.
enum LinkableEntityType {
  TASK
  SUBTASK
  BUG_REPORT
  TEST_CASE
  TEST_RUN
  BRD_DOCUMENT
  REQUIREMENT
  SPRINT
  EPIC
  MANUAL_TEST_SESSION
}

// A generic link between any two entities in a project.
//
// The purpose-built link tables (TaskTestCase, TaskBug, BrdLink) stay as they
// are — they carry their own semantics and existing UI. This is the fallback
// for every pair that has no dedicated table, so traceability doesn't need a
// new join table per combination.
//
// Stored one-directional, read bidirectionally: a query for an entity's links
// matches it as either source or target, so a link created from a task shows up
// on the bug too without writing two rows.
model EntityLink {
  id        String @id @default(cuid())
  projectId String

  sourceId   String
  sourceType LinkableEntityType

  targetId   String
  targetType LinkableEntityType

  // Human-readable relationship, e.g. "relates to", "blocks", "verifies".
  // Null is treated as "relates to".
  relationLabel String?

  createdAt DateTime @default(now())
  createdBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceType, targetId, targetType, relationLabel])
  @@index([projectId])
  @@index([sourceId, sourceType])
  @@index([targetId, targetType])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Visual tests
//
//  Screenshot every page of a site (FullWebsite: from its sitemap; UrlList: from
//  a list someone typed or uploaded) on each browser/screen size, compare each
//  screenshot with the last APPROVED one for the same page + environment, and
//  hand the differences to a person to accept or reject. Flow tests reuse the
//  same machinery for "Visually check this screen" steps inside a test case.
//
//  A baseline only ever changes when a person accepts a screen (or a first run
//  records a page nobody has seen before). That is the whole point: a
//  comparison against "whatever the last run saw" would silently approve every
//  regression one run after it shipped.
// ─────────────────────────────────────────────────────────────────────────────

enum VisualTestType {
  FullWebsite
  UrlList
  Flow
}

enum VisualMatchLevel {
  // Every pixel that a person would see as different.
  Strict
  // Strict, but text that is expected to change between runs (dates, numbers,
  // prices, emails, links, form values) is masked before comparing.
  Dynamic
  // Compare lightness only — a colour/theme change is not a difference.
  IgnoreColors
}

enum VisualCaptureType {
  FullPage
  Viewport
}

enum VisualRunStatus {
  Queued
  Running
  Completed
  Failed
  Cancelled
}

enum VisualOutcome {
  Passed
  Unresolved
  Failed
}

enum VisualScreenStatus {
  // First time this page + environment was seen; the image became the baseline.
  New
  Passed
  // Differs from the baseline and is waiting for a person.
  Unresolved
  Accepted
  Rejected
  // The page could not be captured (HTTP error, timeout, crash).
  Error
  // The page was in the last run but is no longer in the sitemap/list.
  Removed
}

enum VisualScreenDiffState {
  Added
  Existing
  Removed
}

model VisualTest {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  type       VisualTestType
  // Site root for FullWebsite, first page for UrlList, start page for Flow.
  startUrl   String
  // Explicit sitemap; when null a FullWebsite test looks in robots.txt, then /sitemap.xml.
  sitemapUrl String?
  maxUrls    Int      @default(100)
  // Path prefixes ("/blog/") left out now AND for pages the sitemap adds later.
  excludedFolders String[] @default([])

  // Flow tests belong to exactly one test case.
  testCaseId String?   @unique
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  // The module (TestSuite) bugs filed from this test land in.
  suiteId String?
  suite   TestSuite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)

  // Sign in with this login before capturing pages.
  credentialId String?
  credential   ProjectCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  // [{ key, name, browser: "chromium"|"firefox"|"webkit", width, height, device? }]
  environments        Json
  matchLevel          VisualMatchLevel  @default(Strict)
  captureType         VisualCaptureType @default(FullPage)
  waitBeforeCaptureMs Int               @default(0)
  // JavaScript run in the page just before each screenshot (close a banner, freeze a carousel).
  beforeCaptureScript String?
  // Accepting a change also accepts the identical change on other screens.
  autoMaintenance     Boolean           @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages     VisualTestPage[]
  runs      VisualTestRun[]
  screens   VisualScreen[]
  baselines VisualScreenBaseline[]
  regions   VisualTestRegion[]

  @@index([projectId])
  @@index([suiteId])
}

model VisualTestPage {
  id           String     @id @default(uuid())
  visualTestId String
  visualTest   VisualTest @relation(fields: [visualTestId], references: [id], onDelete: Cascade)

  url    String
  // Normalised URL: the identity a page keeps across runs.
  urlKey String
  // First path segment ("/blog/"), "/" for the root — what exclusions work on.
  folder String
  // sitemap | crawl | list | file | manual
  source String   @default("manual")
  excluded Boolean @default(false)
  // Set when a FullWebsite run no longer finds the page in the sitemap.
  removedAt DateTime?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  screens VisualScreen[]

  @@unique([visualTestId, urlKey])
  @@index([visualTestId, excluded])
}

model VisualTestRun {
  id           String     @id @default(uuid())
  visualTestId String
  visualTest   VisualTest @relation(fields: [visualTestId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Flow checkpoints: the functional test run whose steps produced the screens.
  testRunId String?
  testRun   TestRun? @relation(fields: [testRunId], references: [id], onDelete: SetNull)

  status  VisualRunStatus @default(Queued)
  // Null until the run has screens to judge; recomputed on every accept/reject.
  outcome VisualOutcome?

  // Settings as they were when the run started, so editing the test later does
  // not rewrite what an old run claims it checked.
  environments Json
  matchLevel   VisualMatchLevel
  captureType  VisualCaptureType

  totalScreens    Int @default(0)
  doneScreens     Int @default(0)
  passedCount     Int @default(0)
  unresolvedCount Int @default(0)
  failedCount     Int @default(0)
  newCount        Int @default(0)
  addedPages      Int @default(0)
  removedPages    Int @default(0)

  error         String?
  triggeredById String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  screens VisualScreen[]

  @@index([visualTestId, createdAt])
  @@index([projectId, createdAt])
  @@index([testRunId])
}

model VisualScreen {
  id           String        @id @default(uuid())
  runId        String
  run          VisualTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Denormalised so "every unresolved screen of this test" is one indexed query.
  visualTestId String
  visualTest   VisualTest    @relation(fields: [visualTestId], references: [id], onDelete: Cascade)
  pageId       String?
  page         VisualTestPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  // Page URL, or the checkpoint's name for a flow.
  name      String
  // urlKey for pages, "step:<testStepId>" for flow checkpoints.
  screenKey String
  url       String?
  stepId    String?

  envKey   String
  envName  String
  browser  String
  viewport String

  status    VisualScreenStatus
  diffState VisualScreenDiffState @default(Existing)

  httpStatus   Int?
  errorMessage String?
  loadMs       Int?

  actualImagePath   String?
  // The approved image this screen was compared with (null for New).
  baselineImagePath String?
  diffImagePath     String?
  width             Int?
  height            Int?
  mismatchPercent   Float?
  // [{ x, y, width, height, pixels, hashBase, hashActual }]
  diffRegions       Json?
  // Text boxes masked by the Dynamic match level: [{ x, y, width, height }]
  dynamicRects      Json?

  resolvedById     String?
  resolvedAt       DateTime?
  // True when auto-maintenance, not a person, accepted/rejected this screen.
  resolvedByAuto   Boolean   @default(false)
  // The screen a person resolved that caused this one to be resolved.
  autoFromScreenId String?

  bugReportId String?
  bugReport   BugReport? @relation(fields: [bugReportId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([visualTestId, status])
  @@index([visualTestId, screenKey, envKey])
  @@index([autoFromScreenId])
}

model VisualScreenBaseline {
  id           String     @id @default(uuid())
  visualTestId String
  visualTest   VisualTest @relation(fields: [visualTestId], references: [id], onDelete: Cascade)

  screenKey    String
  envKey       String
  imagePath    String
  width        Int
  height       Int
  dynamicRects Json?

  // The screen whose image this is. Undo restores the previous pair.
  sourceScreenId         String?
  previousImagePath      String?
  previousWidth          Int?
  previousHeight         Int?
  previousDynamicRects   Json?
  previousSourceScreenId String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([visualTestId, screenKey, envKey])
}

// Areas left out of the comparison (a rotating banner, an ad, a clock).
model VisualTestRegion {
  id           String     @id @default(uuid())
  visualTestId String
  visualTest   VisualTest @relation(fields: [visualTestId], references: [id], onDelete: Cascade)

  // null = every screen of the test / every environment.
  screenKey String?
  envKey    String?

  x      Int
  y      Int
  width  Int
  height Int
  note   String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([visualTestId])
}

// A named set of Scrum Board filters ("My open bugs", "Unestimated stories").
// `query` is the board's URL query (filters + view), so a view restores
// exactly what its author saw. Shared views are listed for the whole project.
model ScrumSavedView {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ScrumSavedViewOwner", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
}
