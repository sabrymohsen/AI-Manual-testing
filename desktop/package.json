{
  "name": "qa-engine-desktop",
  "productName": "QA Engine",
  "version": "0.6.2",
  "description": "QA Engine desktop app for macOS and Windows",
  "author": "QA Engine",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "QA_ENGINE_URL=http://localhost:3000 electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "dependencies": {
    "@playwright/cli": "0.1.13",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.qaengine.desktop",
    "productName": "QA Engine",
    "copyright": "QA Engine",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "QA-Engine-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "QA-Engine-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "QA-Engine-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sabrymohsen",
        "repo": "AI-Manual-testing",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/@playwright/cli/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ]
  },
  "allowScripts": {
    "electron@45.3.1": true
  }
}
