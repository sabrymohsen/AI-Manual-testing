# HTTPS certificates are issued automatically (Let's Encrypt) for both names.
{$DOMAIN} {
	encode gzip
	# Live notifications / chat (socket.io). /internal/* on the socket server is NOT exposed.
	handle /socket.io/* {
		reverse_proxy socket:3001
	}
	# Desktop installers (copied to ~/qa-engine-downloads on the server).
	handle_path /downloads/* {
		root * /srv/downloads
		# A real file name and type, so browsers save "QA-Engine-Setup.exe" (not a
		# nameless file Windows asks to "Open with").
		@download not path *.json
		header @download Content-Disposition "attachment; filename=\"{http.request.uri.path.file}\""
		@exe path *.exe
		header @exe Content-Type application/vnd.microsoft.portable-executable
		@zip path *.zip
		header @zip Content-Type application/zip
		@dmg path *.dmg
		header @dmg Content-Type application/x-apple-diskimage
		@json path *.json
		header @json Cache-Control no-store
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}

# Live QA / recorder: the browser opens a WebSocket to this host directly.
recorder.{$DOMAIN} {
	reverse_proxy recorder:3847
}
